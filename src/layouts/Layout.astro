---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** OG image absolut/path kalau nanti sudah ada (Fase D). */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Portofolio Ridwan Afazn — software engineer yang membangun sistem produksi: LMS dengan pembayaran & sertifikat terverifikasi, ledger double-entry, dan platform event real-time.',
  image,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const faviconUrl = `${base.endsWith('/') ? base : base + '/'}favicon.svg`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={faviconUrl} />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content="#EDEBE4" />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <!-- Open Graph / Twitter -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Ridwan Afazn" />
        <meta property="og:locale" content="id_ID" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}

        <!-- Font self-host: preload yang dipakai di atas lipatan -->
        <link rel="preload" href="/fonts/bricolage-grotesque-normal-var.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/public-sans-normal-var.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/jetbrains-mono-normal-var.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />

        <script is:inline>
          // Hanya sembunyikan elemen .reveal kalau JS benar-benar jalan.
          document.documentElement.classList.add('js');
        </script>
    </head>
    
    <body class="flex flex-col min-h-screen relative overflow-x-hidden">

        <a href="#main" class="skip-link">Langsung ke konten</a>

        <Navbar />
        
        <main id="main" class="flex-grow pt-24 md:pt-28 pb-24 px-6 md:px-12 max-w-7xl mx-auto w-full relative z-10">
            <slot />
        </main>
        
        <Footer />

        <slot name="overlay" />

        <script>
          let revealObserver: IntersectionObserver | null = null;
          const pending = new Set<HTMLElement>();
          let ioDelivered = false;
          let fallbackTimer = 0;

          const revealNow = (el: Element) => {
            el.classList.add('visible');
            pending.delete(el as HTMLElement);
          };

          const initReveal = () => {
            const elements = Array.from(document.querySelectorAll<HTMLElement>('.reveal:not(.visible)'));
            if (!elements.length) return;

            if (!revealObserver) {
              revealObserver = new IntersectionObserver(
                (entries) => {
                  ioDelivered = true;
                  entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                      revealNow(entry.target);
                      revealObserver?.unobserve(entry.target);
                    }
                  });
                },
                { threshold: 0.05, rootMargin: '0px 0px -2% 0px' },
              );
            }

            const viewport = window.innerHeight;
            elements.forEach((el) => {
              // Satu layar pertama (plus sedikit) langsung dianimasikan tanpa
              // menunggu IntersectionObserver — konten tidak boleh tertahan.
              if (el.getBoundingClientRect().top < viewport * 1.05) {
                revealNow(el);
              } else {
                pending.add(el);
                revealObserver!.observe(el);
              }
            });

            // Jaring pengaman: kalau IO tidak pernah mengirim callback
            // (mis. renderer tanpa frame), tampilkan semua.
            window.clearTimeout(fallbackTimer);
            fallbackTimer = window.setTimeout(() => {
              if (ioDelivered) return;
              pending.forEach((el) => el.classList.add('visible'));
              pending.clear();
            }, 2500);
          };

          document.addEventListener('astro:page-load', initReveal);
          document.addEventListener('astro:before-swap', () => {
            revealObserver?.disconnect();
            revealObserver = null;
            pending.clear();
            ioDelivered = false;
            window.clearTimeout(fallbackTimer);
          });

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initReveal);
          } else {
            initReveal();
          }

          // Fallback kalau ClientRouter tidak menyala.
          window.setTimeout(initReveal, 400);
        </script>
    </body>
</html>
