---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Tag from '../components/Tag.astro';
import { getProfile, getActivities } from '../lib/content';

const profileData = await getProfile();
const activitiesData = await getActivities();

const experience = profileData.experience ?? [];
const education = profileData.education ?? [];
const certifications = profileData.certifications ?? [];

const pad = (n: number) => String(n).padStart(2, '0');
const formatPeriod = (period: string) => period.replace(/\s+-\s+/g, ' — ');

// Stat dari DB dipetakan ke label UI Indonesia; fallback ke label asli.
const headerStats = (profileData.stats ?? []).slice(0, 4).map((stat) => ({
  label: /professional/i.test(stat.label)
    ? 'Sejak'
    : /role/i.test(stat.label)
      ? 'Peran'
      : /project/i.test(stat.label)
        ? 'Proyek'
        : /cert/i.test(stat.label)
          ? 'Sertifikasi'
          : stat.label,
  value: stat.value,
}));
---

<Layout
  title="Tentang · Ridwan Pages"
  description="Latar belakang, pengalaman, pendidikan, sertifikasi, dan kegiatan Ridwan Afazn."
  image="/og.png"
>
  <PageHeader
    class="relative z-10"
    title="Di Balik Kode"
    description="Fondasi akademis, sertifikasi, dan pengalaman lapangan yang membentuk cara saya membangun sistem."
  >
    {headerStats.length > 0 && (
      <dl slot="meta" class="border-t border-outline-strong">
        {headerStats.map((stat) => (
          <div class="flex items-baseline justify-between gap-4 border-b border-outline py-2.5">
            <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">
              {stat.label}
            </dt>
            <dd class="font-mono text-[13px] tabular-nums text-on-background">{stat.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </PageHeader>

  <section aria-labelledby="pengalaman" class="relative z-10 mb-14 md:mb-20">
    <SectionHeader id="pengalaman" title="Pengalaman" meta={`${pad(experience.length)} entri`} />

    {experience.length > 0 ? (
      <ol>
        {experience.map((exp, index) => (
          <li class="group border-b border-outline transition-colors hover:bg-surface-hover">
            <div class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-4 gap-y-2 py-6 md:grid-cols-[2.5rem_11rem_minmax(0,1fr)] md:gap-x-6 md:py-7">
              <span class="font-mono text-[12px] tabular-nums text-signal-strong">
                {pad(index + 1)}
              </span>
              <span class="font-mono text-[12px] uppercase tracking-[0.08em] text-on-surface-variant md:pt-1.5">
                {formatPeriod(exp.period)}
              </span>
              <div class="col-start-2 md:col-start-3 md:row-start-1">
                <h3 class="font-heading text-xl leading-snug tracking-tight text-on-background md:text-2xl">
                  {exp.role}
                </h3>
                <p class="mt-1 font-mono text-[12px] font-semibold text-on-surface-variant">
                  {exp.organization}
                </p>
                {exp.description && (
                  <p class="mt-3 max-w-[60ch] text-[14px] leading-relaxed text-on-surface-variant">
                    {exp.description}
                  </p>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="border-b border-outline py-6 text-[14px] text-on-surface-variant">
        Belum ada pengalaman yang dipublikasikan.
      </p>
    )}
  </section>

  <section aria-labelledby="pendidikan" class="relative z-10 mb-14 md:mb-20">
    <SectionHeader id="pendidikan" title="Pendidikan" meta={`${pad(education.length)} entri`} />

    {education.length > 0 ? (
      <div class="mt-6 grid gap-x-8 gap-y-6 md:grid-cols-2">
        {education.map((edu) => (
          <article class="border-b border-outline pb-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-heading text-xl leading-snug tracking-tight text-on-background">
                {edu.degree}
              </h3>
              <span class="font-mono text-[12px] tabular-nums text-on-surface-variant">
                GPA {edu.gpa}
              </span>
            </div>
            <p class="mt-1 font-mono text-[12px] font-semibold text-on-surface-variant">
              {edu.institution}
            </p>
            {edu.highlights.length > 0 && (
              <ul class="mt-4 space-y-2.5">
                {edu.highlights.map((highlight) => (
                  <li class="flex items-start gap-3 text-[13px] leading-relaxed text-on-surface-variant">
                    <span class="mt-[9px] h-px w-3 shrink-0 bg-outline-strong" aria-hidden="true"></span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="border-b border-outline py-6 text-[14px] text-on-surface-variant">
        Belum ada data pendidikan.
      </p>
    )}
  </section>

  <section aria-labelledby="sertifikasi" class="relative z-10 mb-14 md:mb-20">
    <SectionHeader id="sertifikasi" title="Sertifikasi" meta={`${pad(certifications.length)} entri`} />

    {certifications.length > 0 ? (
      <ul class="mt-6 grid gap-x-8 md:grid-cols-2">
        {certifications.map((cert) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-outline py-4">
            <span class="text-[14px] font-semibold text-on-background">{cert.name}</span>
            <span class="shrink-0 font-mono text-[12px] text-on-surface-variant">{cert.issuer}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="border-b border-outline py-6 text-[14px] text-on-surface-variant">
        Belum ada sertifikasi.
      </p>
    )}
  </section>

  <section aria-labelledby="volunteering" class="relative z-10">
    <SectionHeader id="volunteering" title="Volunteering" meta={`${pad(activitiesData.length)} entri`} />

    {activitiesData.length > 0 ? (
      <div class="mt-6 grid gap-x-8 gap-y-8 md:grid-cols-2">
        {activitiesData.map((activity) => (
          <article class="border-b border-outline pb-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <h3 class="font-heading text-lg leading-snug tracking-tight text-on-background md:text-xl">
                {activity.title}
              </h3>
              <Tag>{activity.type}</Tag>
            </div>
            <p class="mt-1 font-mono text-[12px] font-semibold text-on-surface-variant">
              {activity.organization}
            </p>
            <p class="mt-3 max-w-[60ch] text-[13px] leading-relaxed text-on-surface-variant">
              {activity.description}
            </p>
            {activity.highlights.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {activity.highlights.map((highlight) => (
                  <li>
                    <Tag>{highlight}</Tag>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="border-b border-outline py-6 text-[14px] text-on-surface-variant">
        Belum ada kegiatan yang dipublikasikan.
      </p>
    )}
  </section>
</Layout>
