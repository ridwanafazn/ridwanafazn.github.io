---
// src/pages/admin/index.astro — dashboard (SSR, protected)
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminStats, listPortfolios } from '../../lib/queries';

const user = Astro.locals.user;
const firstName = user?.name?.split(' ')[0] ?? 'Admin';

let stats = { portfolios: 0, published: 0, draft: 0, assets: 0, activities: 0 };
let recent: Awaited<ReturnType<typeof listPortfolios>> = [];
let error: string | null = null;

try {
  [stats, recent] = await Promise.all([getAdminStats(), listPortfolios({ limit: 5 })]);
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const cards = [
  {
    label: 'Total project',
    value: stats.portfolios,
    href: '/admin/portfolio',
    icon: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  },
  {
    label: 'Published',
    value: stats.published,
    href: '/admin/portfolio?status=published',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    label: 'Draft',
    value: stats.draft,
    href: '/admin/portfolio?status=draft',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  },
  {
    label: 'Asset',
    value: stats.assets,
    href: '/admin/assets',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
  {
    label: 'Activity',
    value: stats.activities,
    href: '/admin/activities',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];

const quickActions = [
  {
    href: '/admin/portfolio/new',
    label: 'Project baru',
    description: 'Tambah karya ke portfolio',
    icon: 'M12 4v16m8-8H4',
  },
  {
    href: '/admin/assets',
    label: 'Upload asset',
    description: 'Simpan gambar project',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
  {
    href: '/admin/profile',
    label: 'Profil',
    description: 'Perbarui info dan pengalaman',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  },
  {
    href: '/',
    label: 'Lihat situs',
    description: 'Buka halaman publik',
    icon: 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14',
    external: true,
  },
];
---

<AdminLayout title="Dashboard">
  <section class="mb-8">
    <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-on-surface-variant">Overview</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-on-background sm:text-[2rem]">
      Halo, {firstName}
    </h1>
    <p class="mt-1.5 text-sm text-on-surface-variant">Ringkasan konten portfolio kamu hari ini.</p>
  </section>

  {
    error && (
      <p class="mb-6 rounded-xl border border-accent/30 bg-accent/10 p-4 text-sm text-on-surface-variant">
        DB belum siap: <span class="font-mono">{error}</span>
      </p>
    )
  }

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {
      cards.map((c) => (
        <a
          href={c.href}
          class="group relative overflow-hidden rounded-2xl border border-outline bg-surface p-4 transition duration-200 hover:-translate-y-0.5 hover:border-outline-strong hover:shadow-[0_8px_24px_-18px_rgba(22,21,26,0.5)] sm:p-5"
        >
          <div class="flex items-start justify-between">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent/10 text-accent">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
              </svg>
            </span>
            <svg class="h-4 w-4 -translate-x-1 text-on-surface-variant opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
          <p class="mt-5 font-heading text-3xl font-bold tabular-nums leading-none text-on-background">{c.value}</p>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant">{c.label}</p>
        </a>
      ))
    }
  </section>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[1.55fr_1fr]">
    <section class="overflow-hidden rounded-2xl border border-outline bg-surface">
      <div class="flex items-center justify-between border-b border-outline/70 px-5 py-4">
        <div>
          <h2 class="text-sm font-bold text-on-background">Project terbaru</h2>
          <p class="mt-0.5 text-[11px] text-on-surface-variant">Lima project yang terakhir kamu perbarui.</p>
        </div>
        <a href="/admin/portfolio" class="rounded-lg border border-outline px-2.5 py-1.5 text-[11px] font-semibold text-on-surface-variant transition hover:border-accent hover:text-accent">
          Kelola
        </a>
      </div>

      {
        recent.length === 0 ? (
          <p class="px-5 py-10 text-center text-sm text-on-surface-variant">Belum ada project.</p>
        ) : (
          <ul class="divide-y divide-outline/60">
            {recent.map((p) => (
              <li>
                <a href={`/admin/portfolio/${p.id}`} class="group flex items-center gap-3 px-5 py-3.5 transition hover:bg-surface-hover/70">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-on-background font-heading text-xs font-bold uppercase text-background">
                    {p.title.slice(0, 1)}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-semibold text-on-background group-hover:text-accent">{p.title}</span>
                    <span class="block truncate text-[11px] text-on-surface-variant">{p.role}</span>
                  </span>
                  <span class:list={[
                    'shrink-0 rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider',
                    p.status === 'published'
                      ? 'border-success/25 bg-success/10 text-success'
                      : p.status === 'archived'
                        ? 'border-outline bg-surface-hover text-on-surface-variant'
                        : 'border-accent/25 bg-accent/10 text-accent',
                  ]}>{p.status}</span>
                  <svg class="h-4 w-4 shrink-0 text-on-surface-variant opacity-0 transition group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="rounded-2xl border border-outline bg-surface p-5">
      <h2 class="text-sm font-bold text-on-background">Aksi cepat</h2>
      <p class="mt-0.5 text-[11px] text-on-surface-variant">Pintasan ke pekerjaan yang sering dipakai.</p>

      <div class="mt-4 grid grid-cols-2 gap-2.5">
        {
          quickActions.map((a) => (
            <a
              href={a.href}
              target={a.external ? '_blank' : undefined}
              rel={a.external ? 'noopener noreferrer' : undefined}
              class="group flex flex-col gap-3 rounded-xl border border-outline bg-background/50 p-3.5 transition hover:border-accent/40 hover:bg-accent/5"
            >
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-surface text-accent ring-1 ring-outline transition group-hover:ring-accent/30">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d={a.icon} />
                </svg>
              </span>
              <span>
                <span class="block text-[12px] font-semibold leading-tight text-on-background">{a.label}</span>
                <span class="mt-0.5 block text-[10px] leading-snug text-on-surface-variant">{a.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</AdminLayout>
