---
// src/pages/admin/assets/index.astro — asset manager (SSR)
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAssets } from '../../../lib/queries';
import { getTransformUrl } from '../../../lib/cloudinary';

let rows: Awaited<ReturnType<typeof listAssets>> = [];
let error: string | null = null;

try {
  rows = await listAssets({});
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}
---

<AdminLayout title="Assets">
  <div class="mb-6">
    <h2 class="text-2xl font-bold tracking-tight text-on-background sm:text-3xl">Assets</h2>
    <p class="mt-1 text-sm text-on-surface-variant">{rows.length} gambar di Cloudinary</p>
  </div>

  {
    error && (
      <p class="mb-6 border border-accent/30 bg-accent/10 p-4 text-sm text-on-surface-variant">
        <span class="font-mono">{error}</span>
      </p>
    )
  }

  <form id="upload-form" class="mb-8 border border-outline bg-surface p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <label
        id="drop-zone"
        for="asset-file"
        class="flex flex-1 cursor-pointer items-center gap-3 border border-dashed border-outline px-4 py-4 transition-colors duration-150 hover:border-accent"
      >
        <span class="grid h-10 w-10 place-items-center bg-accent/10 text-accent">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
          </svg>
        </span>
        <span class="min-w-0">
          <span id="file-label" class="block truncate text-sm font-semibold text-on-background">Pilih gambar atau tarik ke sini</span>
          <span class="block text-[11px] text-on-surface-variant">Bisa banyak file sekaligus · JPG, PNG, WEBP, AVIF · maks 10 MB per file</span>
        </span>
        <input id="asset-file" type="file" name="file" accept="image/*" multiple class="sr-only" />
      </label>

      <button
        type="submit"
        id="upload"
        class="bg-on-background px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-background transition-colors duration-150 disabled:opacity-50"
      >
        Upload
      </button>
    </div>

    <div id="upload-progress" class="mt-4 hidden">
      <div class="h-1 w-full bg-outline/60">
        <div id="upload-bar" class="h-full w-0 bg-accent transition-[width] duration-150"></div>
      </div>
      <p id="upload-status" class="mt-2 text-xs text-on-surface-variant"></p>
    </div>

    <ul id="upload-errors" class="mt-3 hidden space-y-1 text-xs text-error"></ul>
  </form>

  {
    rows.length === 0 && !error && (
      <div class="border border-dashed border-outline p-10 text-center text-sm text-on-surface-variant">
        Belum ada asset. Upload gambar pertama di atas.
      </div>
    )
  }

  {rows.length > 0 && (
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {rows.map((a) => (
        <figure class="group relative overflow-hidden border border-outline bg-surface">
          <img
            src={getTransformUrl(a.cloudinaryPublicId, { w: 400, c: 'fill', h: 300 })}
            alt={a.originalName ?? a.cloudinaryPublicId}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="truncate border-t border-outline px-2.5 py-1.5 text-[10px] text-on-surface-variant">
            {a.originalName ?? a.cloudinaryPublicId}
          </figcaption>
          <div class="absolute inset-0 flex items-end justify-center gap-1.5 bg-gradient-to-t from-black/60 via-transparent to-transparent p-2 opacity-0 transition-opacity duration-150 group-hover:opacity-100">
            <button
              type="button"
              data-action="delete-asset"
              data-id={a.id}
              class="bg-error px-2 py-1 text-[10px] font-bold uppercase text-white"
            >
              Delete
            </button>
          </div>
        </figure>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  const MAX_BYTES = 10 * 1024 * 1024;
  const CONCURRENCY = 3;

  const statusEl = document.getElementById('upload-status');
  const progressEl = document.getElementById('upload-progress');
  const barEl = document.getElementById('upload-bar');
  const errorsEl = document.getElementById('upload-errors');
  const form = document.getElementById('upload-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('asset-file') as HTMLInputElement | null;
  const fileLabel = document.getElementById('file-label');
  const dropZone = document.getElementById('drop-zone');
  const submitBtn = document.getElementById('upload') as HTMLButtonElement | null;

  const notify = (m: string, t: 'success' | 'error' = 'success') =>
    (window as any).toast?.(m, t);

  const selectedFiles = () => Array.from(fileInput?.files ?? []);

  const refreshLabel = () => {
    if (!fileLabel) return;
    const files = selectedFiles();
    if (files.length === 0) fileLabel.textContent = 'Pilih gambar atau tarik ke sini';
    else if (files.length === 1) fileLabel.textContent = files[0].name;
    else fileLabel.textContent = `${files.length} gambar dipilih`;
  };

  const setProgress = (done: number, total: number, text: string) => {
    progressEl?.classList.remove('hidden');
    if (barEl) barEl.style.width = `${total > 0 ? Math.round((done / total) * 100) : 0}%`;
    if (statusEl) statusEl.textContent = text;
  };

  const showErrors = (failures: { name: string; message: string }[]) => {
    if (!errorsEl) return;
    errorsEl.innerHTML = '';
    if (failures.length === 0) {
      errorsEl.classList.add('hidden');
      return;
    }
    for (const failure of failures) {
      const li = document.createElement('li');
      li.textContent = `${failure.name}: ${failure.message}`;
      errorsEl.appendChild(li);
    }
    errorsEl.classList.remove('hidden');
  };

  fileInput?.addEventListener('change', refreshLabel);

  // Drag & drop ke area upload
  if (dropZone && fileInput) {
    const setDragging = (on: boolean) => {
      dropZone.classList.toggle('border-accent', on);
      dropZone.classList.toggle('bg-accent/5', on);
    };

    for (const event of ['dragenter', 'dragover']) {
      dropZone.addEventListener(event, (e) => {
        e.preventDefault();
        setDragging(true);
      });
    }

    for (const event of ['dragleave', 'dragend']) {
      dropZone.addEventListener(event, () => setDragging(false));
    }

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      setDragging(false);
      const dropped = (e as DragEvent).dataTransfer?.files;
      if (dropped && dropped.length > 0) {
        fileInput.files = dropped;
        fileInput.dispatchEvent(new Event('change'));
      }
    });
  }

  const uploadOne = async (
    file: File,
    sign: Record<string, string | number>,
  ): Promise<void> => {
    const fd = new FormData();
    for (const [key, value] of Object.entries(sign)) fd.append(key, String(value));
    fd.append('file', file);

    const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
    const cloudRes = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/auto/upload`, {
      method: 'POST',
      body: fd,
    });
    if (!cloudRes.ok) throw new Error((await cloudRes.text()).slice(0, 180));

    const uploaded = await cloudRes.json();
    const saveRes = await fetch('/admin/api/assets', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        cloudinaryPublicId: uploaded.public_id,
        originalName: file.name,
        mimeType: uploaded.resource_type === 'image' ? `image/${uploaded.format}` : undefined,
        width: uploaded.width,
        height: uploaded.height,
        bytes: uploaded.bytes,
        format: uploaded.format,
        folder: 'portfolio',
      }),
    });
    if (!saveRes.ok) throw new Error(await saveRes.text());
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const picked = selectedFiles();
    if (picked.length === 0) {
      notify('Pilih minimal satu gambar', 'error');
      return;
    }

    const valid = picked.filter((file) => file.type.startsWith('image/') && file.size <= MAX_BYTES);
    const skipped = picked
      .filter((file) => !valid.includes(file))
      .map((file) => ({
        name: file.name,
        message: file.size > MAX_BYTES ? 'lebih dari 10 MB' : 'bukan file gambar',
      }));

    if (valid.length === 0) {
      showErrors(skipped);
      notify('Tidak ada file yang bisa diupload', 'error');
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    showErrors([...skipped]);
    setProgress(0, valid.length, 'Meminta signature…');

    const failures: { name: string; message: string }[] = [...skipped];
    let succeeded = 0;
    let completed = 0;

    try {
      const signRes = await fetch('/admin/api/assets/sign-upload', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ folder: 'portfolio' }),
      });
      if (!signRes.ok) throw new Error(await signRes.text());
      const sign = await signRes.json();

      let cursor = 0;
      const worker = async () => {
        while (cursor < valid.length) {
          const file = valid[cursor++];
          try {
            await uploadOne(file, sign);
            succeeded++;
          } catch (err) {
            failures.push({
              name: file.name,
              message: err instanceof Error ? err.message : String(err),
            });
          } finally {
            completed++;
            setProgress(completed, valid.length, `Mengunggah ${completed} dari ${valid.length}…`);
          }
        }
      };

      await Promise.all(
        Array.from({ length: Math.min(CONCURRENCY, valid.length) }, () => worker()),
      );

      if (failures.length === 0) {
        setProgress(valid.length, valid.length, `Selesai. ${succeeded} asset diunggah.`);
        notify(`${succeeded} asset berhasil diupload`);
        setTimeout(() => location.reload(), 700);
      } else {
        showErrors(failures);
        setProgress(
          valid.length,
          valid.length,
          `Selesai. ${succeeded} berhasil, ${failures.length} gagal.`,
        );
        notify(`${succeeded} berhasil, ${failures.length} gagal`, 'error');
        if (succeeded > 0) setTimeout(() => location.reload(), 1800);
      }
    } catch (err) {
      setProgress(completed, valid.length, 'Upload gagal.');
      notify(`Gagal upload: ${err}`, 'error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-action="delete-asset"]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Hapus asset ini?')) return;
      const res = await fetch(`/admin/api/assets/${btn.dataset.id}`, { method: 'DELETE' });
      if (res.ok) {
        (window as any).toast?.('Asset dihapus');
        setTimeout(() => location.reload(), 400);
      } else {
        (window as any).toast?.(`Gagal: ${await res.text()}`, 'error');
      }
    });
  });
</script>
