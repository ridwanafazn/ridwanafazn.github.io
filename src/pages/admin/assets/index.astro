---
// src/pages/admin/assets/index.astro — asset manager (SSR)
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAssets } from '../../../lib/queries';
import { getTransformUrl } from '../../../lib/cloudinary';

let rows: Awaited<ReturnType<typeof listAssets>> = [];
let error: string | null = null;

try {
  rows = await listAssets({});
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}
---

<AdminLayout title="Assets">
  <div class="mb-6">
    <h2 class="text-2xl font-bold tracking-tight text-on-background sm:text-3xl">Assets</h2>
    <p class="mt-1 text-sm text-on-surface-variant">{rows.length} gambar di Cloudinary</p>
  </div>

  {
    error && (
      <p class="mb-6 rounded-lg border border-accent/30 bg-accent/10 p-4 text-sm text-on-surface-variant">
        <span class="font-mono">{error}</span>
      </p>
    )
  }

  <form id="upload-form" class="mb-8 rounded-xl border border-outline bg-surface p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <label
        for="asset-file"
        class="flex flex-1 cursor-pointer items-center gap-3 rounded-lg border border-dashed border-outline px-4 py-4 transition hover:border-accent"
      >
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-accent/10 text-accent">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
          </svg>
        </span>
        <span class="min-w-0">
          <span id="file-label" class="block truncate text-sm font-semibold text-on-background">Pilih gambar…</span>
          <span class="block text-[11px] text-on-surface-variant">JPG, PNG, WEBP, AVIF · maks 10 MB</span>
        </span>
        <input id="asset-file" type="file" name="file" accept="image/*" class="sr-only" />
      </label>

      <button
        type="submit"
        id="upload"
        class="rounded-lg bg-on-background px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-background transition hover:-translate-y-0.5 disabled:opacity-50"
      >
        Upload
      </button>
    </div>
    <p id="upload-status" class="mt-3 text-xs text-on-surface-variant"></p>
  </form>

  {
    rows.length === 0 && !error && (
      <div class="rounded-xl border border-dashed border-outline p-10 text-center text-sm text-on-surface-variant">
        Belum ada asset. Upload gambar pertama di atas.
      </div>
    )
  }

  {rows.length > 0 && (
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {rows.map((a) => (
        <figure class="group relative overflow-hidden rounded-lg border border-outline bg-surface">
          <img
            src={getTransformUrl(a.cloudinaryPublicId, { w: 400, c: 'fill', h: 300 })}
            alt={a.originalName ?? a.cloudinaryPublicId}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="truncate border-t border-outline px-2.5 py-1.5 text-[10px] text-on-surface-variant">
            {a.originalName ?? a.cloudinaryPublicId}
          </figcaption>
          <div class="absolute inset-0 flex items-end justify-center gap-1.5 bg-gradient-to-t from-black/60 via-transparent to-transparent p-2 opacity-0 transition group-hover:opacity-100">
            <button
              type="button"
              data-action="delete-asset"
              data-id={a.id}
              class="rounded-md bg-error px-2 py-1 text-[10px] font-bold uppercase text-white"
            >
              Delete
            </button>
          </div>
        </figure>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  const statusEl = document.getElementById('upload-status');
  const form = document.getElementById('upload-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('asset-file') as HTMLInputElement | null;
  const fileLabel = document.getElementById('file-label');
  const submitBtn = document.getElementById('upload') as HTMLButtonElement | null;

  fileInput?.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (fileLabel) fileLabel.textContent = f ? f.name : 'Pilih gambar…';
  });

  const notify = (m: string, t: 'success' | 'error' = 'success') =>
    (window as any).toast?.(m, t);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const file = fileInput?.files?.[0];
    if (!file) {
      notify('Pilih file dulu', 'error');
      return;
    }

    submitBtn!.disabled = true;
    statusEl!.textContent = 'Meminta signature…';
    try {
      const signRes = await fetch('/admin/api/assets/sign-upload', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ folder: 'portfolio' }),
      });
      if (!signRes.ok) throw new Error(await signRes.text());
      const sign = await signRes.json();

      const fd = new FormData();
      for (const [k, v] of Object.entries(sign)) fd.append(k, String(v));
      fd.append('file', file);

      statusEl!.textContent = `Uploading ${file.name}…`;
      const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
      const cloudRes = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/auto/upload`, {
        method: 'POST',
        body: fd,
      });
      if (!cloudRes.ok) throw new Error(await cloudRes.text());
      const uploaded = await cloudRes.json();

      statusEl!.textContent = 'Menyimpan metadata…';
      const saveRes = await fetch('/admin/api/assets', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          cloudinaryPublicId: uploaded.public_id,
          originalName: file.name,
          mimeType: uploaded.resource_type === 'image' ? `image/${uploaded.format}` : undefined,
          width: uploaded.width,
          height: uploaded.height,
          bytes: uploaded.bytes,
          format: uploaded.format,
          folder: 'portfolio',
        }),
      });
      if (!saveRes.ok) throw new Error(await saveRes.text());

      statusEl!.textContent = '';
      notify('Asset berhasil diupload');
      setTimeout(() => location.reload(), 600);
    } catch (err) {
      statusEl!.textContent = '';
      notify(`Gagal upload: ${err}`, 'error');
    } finally {
      submitBtn!.disabled = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-action="delete-asset"]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Hapus asset ini?')) return;
      const res = await fetch(`/admin/api/assets/${btn.dataset.id}`, { method: 'DELETE' });
      if (res.ok) {
        (window as any).toast?.('Asset dihapus');
        setTimeout(() => location.reload(), 400);
      } else {
        (window as any).toast?.(`Gagal: ${await res.text()}`, 'error');
      }
    });
  });
</script>
