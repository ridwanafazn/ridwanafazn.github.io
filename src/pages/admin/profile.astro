---
// src/pages/admin/profile.astro — editor profil + pengalaman (SSR)
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getProfile } from '../../lib/queries';

let row: Awaited<ReturnType<typeof getProfile>> = null;
let error: string | null = null;

try {
  row = await getProfile();
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const experience = row?.experience ?? [];

const inputClass =
  'w-full border border-outline bg-surface px-3 py-2.5 text-sm text-on-background outline-none transition-colors duration-150 focus:border-accent';
const labelClass = 'flex flex-col gap-1.5';
const labelText = 'text-[11px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant';
---

<AdminLayout title="Profile">
  <section class="mb-7">
    <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-on-surface-variant">Konten</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-on-background">Profile</h1>
    <p class="mt-1.5 text-sm text-on-surface-variant">Info yang tampil di halaman utama dan tentang.</p>
  </section>

  {
    error && (
      <p class="mb-6 border border-accent/30 bg-accent/10 p-4 text-sm text-on-surface-variant">
        <span class="font-mono">{error}</span>. Cek koneksi Neon di <code class="font-mono">.env.local</code>.
      </p>
    )
  }

  <form id="profile-form" class="space-y-6">
    <section class="border border-outline bg-surface p-5 sm:p-6">
      <div class="mb-5">
        <h2 class="text-sm font-bold text-on-background">Identitas</h2>
        <p class="mt-0.5 text-[11px] text-on-surface-variant">Nama, role, dan deskripsi singkat.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class={labelClass}>
          <span class={labelText}>Nama</span>
          <input name="name" required maxlength="100" value={row?.name ?? ''} class={inputClass} />
        </label>
        <label class={labelClass}>
          <span class={labelText}>Nickname</span>
          <input name="nickname" maxlength="50" value={row?.nickname ?? ''} class={inputClass} />
        </label>
        <label class={labelClass}>
          <span class={labelText}>Role</span>
          <input name="role" required maxlength="100" value={row?.role ?? ''} class={inputClass} />
        </label>
        <label class={labelClass}>
          <span class={labelText}>Tagline</span>
          <input name="tagline" maxlength="200" value={row?.tagline ?? ''} class={inputClass} />
        </label>
        <label class={`${labelClass} sm:col-span-2`}>
          <span class={labelText}>Bio</span>
          <textarea name="bio" rows="4" class={inputClass}>{row?.bio ?? ''}</textarea>
        </label>
        <label class={`${labelClass} sm:col-span-2`}>
          <span class={labelText}>URL CV</span>
          <input name="cvUrl" type="url" maxlength="500" placeholder="https://drive.google.com/..." value={row?.cvUrl ?? ''} class={inputClass} />
          <span class="text-[11px] text-on-surface-variant">Dipakai untuk tombol Resume di desktop dan mobile sekaligus.</span>
        </label>
      </div>
    </section>

    <section class="border border-outline bg-surface p-5 sm:p-6">
      <div class="mb-5">
        <h2 class="text-sm font-bold text-on-background">Current focus</h2>
        <p class="mt-0.5 text-[11px] text-on-surface-variant">Yang sedang kamu kerjakan sekarang.</p>
      </div>
      <div class="grid gap-4">
        <label class={labelClass}>
          <span class={labelText}>Judul</span>
          <input name="currentFocusTitle" maxlength="100" value={row?.currentFocus?.title ?? ''} class={inputClass} />
        </label>
        <label class={labelClass}>
          <span class={labelText}>Deskripsi</span>
          <textarea name="currentFocusDescription" rows="3" class={inputClass}>{row?.currentFocus?.description ?? ''}</textarea>
        </label>
      </div>
    </section>

    <section class="border border-outline bg-surface p-5 sm:p-6">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-sm font-bold text-on-background">Pengalaman</h2>
          <p class="mt-0.5 text-[11px] text-on-surface-variant">Seret kartu untuk mengubah urutan tampil di halaman tentang.</p>
        </div>
        <button
          type="button"
          id="experience-add"
          class="border border-outline px-3 py-2 text-[11px] font-semibold text-on-surface-variant transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          Tambah pengalaman
        </button>
      </div>

      <div id="experience-list" class="space-y-3">
        {
          experience.map((exp) => (
            <div class="exp-item border border-outline bg-background/50 p-4" data-exp>
              <div class="flex items-start gap-3">
                <span class="exp-drag mt-1 cursor-grab text-on-surface-variant/60 transition-colors duration-150 hover:text-on-surface-variant active:cursor-grabbing" draggable="true" title="Seret untuk mengurutkan" aria-label="Seret untuk mengurutkan">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="9" cy="6" r="1.4" />
                    <circle cx="15" cy="6" r="1.4" />
                    <circle cx="9" cy="12" r="1.4" />
                    <circle cx="15" cy="12" r="1.4" />
                    <circle cx="9" cy="18" r="1.4" />
                    <circle cx="15" cy="18" r="1.4" />
                  </svg>
                </span>

                <div class="grid flex-1 gap-3 sm:grid-cols-2">
                  <label class={labelClass}>
                    <span class={labelText}>Posisi</span>
                    <input data-field="role" maxlength="120" value={exp.role} class={inputClass} />
                  </label>
                  <label class={labelClass}>
                    <span class={labelText}>Organisasi</span>
                    <input data-field="organization" maxlength="160" value={exp.organization} class={inputClass} />
                  </label>
                  <label class={labelClass}>
                    <span class={labelText}>Periode</span>
                    <input data-field="period" maxlength="80" placeholder="2024 - Sekarang" value={exp.period} class={inputClass} />
                  </label>
                  <label class={`${labelClass} sm:col-span-2`}>
                    <span class={labelText}>Deskripsi</span>
                    <textarea data-field="description" rows="2" class={inputClass}>{exp.description ?? ''}</textarea>
                  </label>
                </div>

                <button
                  type="button"
                  data-remove-exp
                  class="border border-error/25 px-2 py-1 text-[10px] font-semibold text-error transition-colors duration-150 hover:bg-error/10"
                  aria-label="Hapus pengalaman"
                >
                  Hapus
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <p id="experience-empty" class="py-6 text-center text-sm text-on-surface-variant" hidden={experience.length > 0}>
        Belum ada pengalaman. Klik tambah untuk mulai.
      </p>
    </section>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-[11px] text-on-surface-variant">Perubahan langsung tampil di situs setelah disimpan.</p>
      <button
        type="submit"
        id="save"
        class="bg-on-background px-6 py-2.5 text-[11px] font-bold uppercase tracking-wider text-background transition-colors duration-150"
      >
        Simpan profile
      </button>
    </div>
  </form>

  <template id="experience-template">
    <div class="exp-item border border-outline bg-background/50 p-4" data-exp>
      <div class="flex items-start gap-3">
        <span class="exp-drag mt-1 cursor-grab text-on-surface-variant/60 transition-colors duration-150 hover:text-on-surface-variant active:cursor-grabbing" draggable="true" title="Seret untuk mengurutkan" aria-label="Seret untuk mengurutkan">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="9" cy="6" r="1.4" />
            <circle cx="15" cy="6" r="1.4" />
            <circle cx="9" cy="12" r="1.4" />
            <circle cx="15" cy="12" r="1.4" />
            <circle cx="9" cy="18" r="1.4" />
            <circle cx="15" cy="18" r="1.4" />
          </svg>
        </span>

        <div class="grid flex-1 gap-3 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5">
            <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant">Posisi</span>
            <input data-field="role" maxlength="120" class="w-full border border-outline bg-surface px-3 py-2.5 text-sm text-on-background outline-none transition-colors duration-150 focus:border-accent" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant">Organisasi</span>
            <input data-field="organization" maxlength="160" class="w-full border border-outline bg-surface px-3 py-2.5 text-sm text-on-background outline-none transition-colors duration-150 focus:border-accent" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant">Periode</span>
            <input data-field="period" maxlength="80" placeholder="2024 - Sekarang" class="w-full border border-outline bg-surface px-3 py-2.5 text-sm text-on-background outline-none transition-colors duration-150 focus:border-accent" />
          </label>
          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-on-surface-variant">Deskripsi</span>
            <textarea data-field="description" rows="2" class="w-full border border-outline bg-surface px-3 py-2.5 text-sm text-on-background outline-none transition-colors duration-150 focus:border-accent"></textarea>
          </label>
        </div>

        <button
          type="button"
          data-remove-exp
          class="border border-error/25 px-2 py-1 text-[10px] font-semibold text-error transition-colors duration-150 hover:bg-error/10"
          aria-label="Hapus pengalaman"
        >
          Hapus
        </button>
      </div>
    </div>
  </template>
</AdminLayout>

<script>
  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  const list = document.getElementById('experience-list');
  const empty = document.getElementById('experience-empty');
  const template = document.getElementById('experience-template') as HTMLTemplateElement | null;
  const notify = (m: string, t: 'success' | 'error' = 'success') => (window as any).toast?.(m, t);

  const syncEmpty = () => {
    if (!list || !empty) return;
    empty.hidden = list.querySelectorAll('[data-exp]').length > 0;
  };

  const addExperience = () => {
    if (!list || !template) return;
    const node = template.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
    if (!node) return;
    list.appendChild(node);
    syncEmpty();
    node.querySelector<HTMLInputElement>('[data-field="role"]')?.focus();
  };

  document.getElementById('experience-add')?.addEventListener('click', addExperience);

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-exp]');
    if (!btn) return;
    btn.closest('[data-exp]')?.remove();
    syncEmpty();
  });

  // Drag & drop urutan pengalaman
  let dragging: HTMLElement | null = null;

  list?.addEventListener('dragstart', (e) => {
    const handle = (e.target as HTMLElement).closest('.exp-drag');
    if (!handle) return;
    dragging = handle.closest<HTMLElement>('[data-exp]');
    dragging?.classList.add('opacity-40');
    e.dataTransfer?.setData('text/plain', 'experience');
    if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
  });

  list?.addEventListener('dragover', (e) => {
    if (!dragging) return;
    e.preventDefault();
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-exp]')).filter((el) => el !== dragging);
    const next = items.find((el) => {
      const rect = el.getBoundingClientRect();
      return e.clientY < rect.top + rect.height / 2;
    });
    if (next) list.insertBefore(dragging, next);
    else list.appendChild(dragging);
  });

  list?.addEventListener('dragend', () => {
    dragging?.classList.remove('opacity-40');
    dragging = null;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);

    const experience = Array.from(document.querySelectorAll<HTMLElement>('#experience-list [data-exp]'))
      .map((el) => ({
        role: el.querySelector<HTMLInputElement>('[data-field="role"]')?.value.trim() ?? '',
        organization: el.querySelector<HTMLInputElement>('[data-field="organization"]')?.value.trim() ?? '',
        period: el.querySelector<HTMLInputElement>('[data-field="period"]')?.value.trim() ?? '',
        description:
          el.querySelector<HTMLTextAreaElement>('[data-field="description"]')?.value.trim() || undefined,
      }))
      .filter((exp) => exp.role || exp.organization || exp.period);

    const payload = {
      name: fd.get('name'),
      nickname: fd.get('nickname') || undefined,
      role: fd.get('role'),
      tagline: fd.get('tagline') || undefined,
      bio: fd.get('bio') || undefined,
      cvUrl: fd.get('cvUrl') || undefined,
      currentFocus:
        fd.get('currentFocusTitle') || fd.get('currentFocusDescription')
          ? {
              title: String(fd.get('currentFocusTitle')),
              description: String(fd.get('currentFocusDescription')),
            }
          : undefined,
      experience,
    };

    try {
      const res = await fetch('/admin/api/profile', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(await res.text());
      notify('Profile tersimpan');
    } catch (err) {
      notify(`Gagal: ${err}`, 'error');
    }
  });
</script>
