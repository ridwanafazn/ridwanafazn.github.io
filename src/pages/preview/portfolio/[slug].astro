---
// src/pages/preview/portfolio/[slug].astro — preview draft (SSR)
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Badge from '../../../components/Badge.astro';
import { getPortfolioBySlug, getAssetUrlMap } from '../../../lib/queries';
import { getTransformUrl } from '../../../lib/cloudinary';

const { slug } = Astro.params;
let row: Awaited<ReturnType<typeof getPortfolioBySlug>> = null;
let error: string | null = null;
let cover: string | null = null;
let gallery: { url: string; caption?: string; alt?: string }[] = [];

try {
  row = await getPortfolioBySlug(slug!);
  if (!row) {
    error = 'Draft tidak ditemukan.';
  } else {
    const byId = await getAssetUrlMap();
    const coverPublic = row.coverImageId ? byId.get(row.coverImageId) : undefined;
    cover = coverPublic ? getTransformUrl(coverPublic, { w: 1600, c: 'limit' }) : null;
    gallery = [];
    for (const g of row.gallery ?? []) {
      const publicId = byId.get(g.assetId);
      if (!publicId) continue;
      const name = (publicId.split('/').pop() ?? publicId).replace(/\.[^.]+$/, '');
      gallery.push({
        url: getTransformUrl(publicId, { w: 1600, c: 'limit' }),
        caption: g.caption,
        alt: g.alt,
        name,
      });
    }
  }
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const summary = row ? row.longDescription || row.description : '';
const summaryParagraphs = summary
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<Layout title={row ? `${row.title} · Preview · Ridwan Pages` : 'Preview · Ridwan Pages'}>
  <div class="fixed inset-x-0 top-0 z-50 border-b border-accent/30 bg-on-background/95 px-4 py-2 text-center text-sm text-background backdrop-blur">
    <span class="font-bold uppercase tracking-wider">Mode Preview</span>. Ini tampilan draft, belum dipublikasikan.
    {row && <a href={`/admin/portfolio/${row.id}`} class="ml-4 underline underline-offset-4">← Kembali ke Edit</a>}
  </div>

  <div class="pt-12">
    {
      error && (
        <p class="mx-auto max-w-xl rounded-md border border-accent/30 bg-accent/10 p-6 text-sm text-on-surface-variant">
          {error}. Cek koneksi Neon di <code class="font-mono">.env.local</code>.
        </p>
      )
    }

    {
      row && (
        <article class="mx-auto max-w-5xl pt-8">
          <header class="mb-10 text-center">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
              {row.role}
            </span>
            <h1 class="mt-4 text-5xl font-bold text-on-background md:text-6xl">{row.title}</h1>

            <div class="mt-6 flex flex-wrap justify-center gap-2.5">
              {row.techStack.map((tech) => <Badge text={tech} />)}
            </div>
          </header>

          {cover && (
            <figure class="mb-12 flex justify-center">
              <img
                src={cover}
                alt={`${row.title} cover`}
                class="h-auto max-h-[250px] w-auto max-w-full rounded-lg border border-outline bg-surface object-contain shadow-sm md:max-h-[360px]"
                decoding="async"
              />
            </figure>
          )}

          {
            gallery.length > 0 && (
              <section class="mb-12">
                <div class="mb-5 flex items-end justify-between gap-3 border-b border-outline-strong pb-4">
                  <div>
                    <h2 class="text-xl font-bold text-on-background">Galeri</h2>
                    <p class="mt-1 text-[11px] text-on-surface-variant">
                      {gallery.length} foto · geser atau klik untuk memperbesar.
                    </p>
                  </div>
                  <div class="flex shrink-0 gap-2">
                    <button
                      type="button"
                      data-gallery-prev
                      class="gallery-nav grid h-9 w-9 place-items-center rounded-full border border-outline bg-surface text-on-surface-variant transition-all duration-200 hover:border-on-background hover:bg-on-background hover:text-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                      aria-label="Gambar sebelumnya"
                    >
                      <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                    <button
                      type="button"
                      data-gallery-next
                      class="gallery-nav grid h-9 w-9 place-items-center rounded-full border border-outline bg-surface text-on-surface-variant transition-all duration-200 hover:border-on-background hover:bg-on-background hover:text-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                      aria-label="Gambar berikutnya"
                    >
                      <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                  </div>
                </div>

                <div class="gallery-track" data-gallery tabindex="0" aria-label="Galeri preview, geser ke samping">
                  {gallery.map((img, i) => {
                    const alt = img.alt ?? `${row!.title} - gambar ${i + 1}`;
                    const caption = img.caption || img.name || '';
                    return (
                      <figure class="gallery-item group">
                        <button
                          type="button"
                          data-lightbox
                          data-src={img.url}
                          data-alt={alt}
                          data-caption={caption}
                          data-index={i}
                          class="relative block w-full cursor-zoom-in overflow-hidden rounded-lg border border-outline bg-surface transition-all duration-300 hover:border-outline-strong hover:shadow-[0_14px_34px_-18px_rgb(22_21_26/0.45)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                          aria-label={`Perbesar ${caption || alt}`}
                        >
                          <img
                            src={img.url}
                            alt={alt}
                            loading="lazy"
                            decoding="async"
                            class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                          />
                        </button>
                        {caption ? (
                          <figcaption class="mt-2 truncate font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-on-surface-variant/90">
                            {caption}
                          </figcaption>
                        ) : null}
                      </figure>
                    );
                  })}
                </div>

                <div class="mt-4 h-0.5 w-full overflow-hidden rounded-full bg-outline/70" aria-hidden="true">
                  <span data-gallery-progress class="block h-full rounded-full bg-on-background/50 transition-[width] duration-200" style="width: 30%"></span>
                </div>
              </section>
            )
          }

          <div class="bento-card p-6 md:p-12">
            <section>
              <h2 class="mb-4 border-b border-outline/30 pb-4 text-2xl font-bold text-on-background">Ringkasan</h2>
              <div class="space-y-4 text-justify text-[15px] leading-relaxed text-on-surface-variant">
                {summaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </section>

            {
              row.highlights.length > 0 && (
                <section class="mt-12">
                  <h2 class="mb-4 border-b border-outline/30 pb-4 text-xl font-bold text-on-background">Highlights</h2>
                  <ul class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
                    {row.highlights.map((feat) => (
                      <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined mt-0.5 text-[18px] text-accent">check_circle</span>
                        <span class="text-[14px] font-medium text-on-surface-variant">{feat}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }

            {
              row.links.length > 0 && (
                <section class="mt-12">
                  <h2 class="mb-4 border-b border-outline/30 pb-4 text-xl font-bold text-on-background">Links</h2>
                  <div class="mt-6 flex flex-wrap gap-4">
                    {row.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-md border border-outline-strong bg-surface px-5 py-2.5 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant transition hover:bg-on-background hover:text-surface"
                      >
                        <span class="material-symbols-outlined text-[16px]">{link.icon}</span>
                        {link.label}
                      </a>
                    ))}
                  </div>
                </section>
              )
            }
          </div>
        </article>

        <Fragment slot="overlay">
          <div
            id="lightbox"
            class="fixed inset-0 z-[100] hidden items-center justify-center bg-on-background/90 p-4 backdrop-blur-lg"
            role="dialog"
            aria-modal="true"
            aria-label="Gambar diperbesar"
          >
            <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 p-4 md:p-6">
              <span
                id="lightbox-counter"
                class="pointer-events-auto rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-[10px] font-semibold tracking-[0.14em] text-white backdrop-blur"
              >
                1 / 1
              </span>
              <button
                type="button"
                id="lightbox-close"
                class="pointer-events-auto grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-black/30 text-white transition-colors duration-150 hover:bg-black/60"
                aria-label="Tutup gambar"
              >
                <span class="material-symbols-outlined text-[20px]">close</span>
              </button>
            </div>

            <button
              type="button"
              data-lightbox-prev
              class="absolute left-3 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-black/30 text-white backdrop-blur transition-colors duration-150 hover:bg-black/60 md:left-6"
              aria-label="Gambar sebelumnya"
            >
              <span class="material-symbols-outlined text-[22px]">chevron_left</span>
            </button>
            <button
              type="button"
              data-lightbox-next
              class="absolute right-3 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-black/30 text-white backdrop-blur transition-colors duration-150 hover:bg-black/60 md:right-6"
              aria-label="Gambar berikutnya"
            >
              <span class="material-symbols-outlined text-[22px]">chevron_right</span>
            </button>

            <figure class="flex max-h-[88vh] w-full max-w-5xl flex-col items-center gap-3 px-1 md:px-10">
              <img
                id="lightbox-img"
                alt=""
                class="max-h-[70vh] max-w-full rounded-lg object-contain shadow-2xl md:max-h-[76vh]"
              />
              <figcaption
                id="lightbox-caption"
                class="max-w-full truncate text-center font-mono text-[11px] uppercase tracking-[0.12em] text-white/60">
              </figcaption>
            </figure>
          </div>
        </Fragment>
      )
    }
  </div>
</Layout>

<script>
  // Slider galeri: geser per kartu, state tombol, progress bar.
  const track = document.querySelector<HTMLElement>('[data-gallery]');
  const galleryPrev = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const galleryNext = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const galleryProgress = document.querySelector<HTMLElement>('[data-gallery-progress]');

  if (track) {
    const step = (dir: number) => {
      const item = track.querySelector<HTMLElement>('.gallery-item');
      const gap = parseFloat(getComputedStyle(track).columnGap || '12') || 12;
      const dist = item ? item.getBoundingClientRect().width + gap : track.clientWidth;
      track.scrollBy({ left: dir * dist, behavior: 'smooth' });
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (galleryPrev) galleryPrev.disabled = track.scrollLeft <= 2;
      if (galleryNext) galleryNext.disabled = track.scrollLeft >= max - 2;
      if (galleryProgress) {
        const ratio = track.scrollWidth > 0 ? track.clientWidth / track.scrollWidth : 1;
        galleryProgress.style.width = `${Math.min(100, ratio * 100)}%`;
        const travel = max > 0 && ratio < 1 ? (track.scrollLeft / max) * ((1 - ratio) / ratio) * 100 : 0;
        galleryProgress.style.transform = `translateX(${travel}%)`;
      }
    };

    galleryPrev?.addEventListener('click', () => step(-1));
    galleryNext?.addEventListener('click', () => step(1));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      }
    });
    sync();
  }

  // Lightbox galeri: navigasi prev/next, counter, keyboard.
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxClose = document.getElementById('lightbox-close');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox]'));
  let current = 0;

  const render = (index: number) => {
    const total = triggers.length;
    if (!lightboxImg || !total) return;
    current = (index + total) % total;
    const btn = triggers[current];
    lightboxImg.src = btn.dataset.src ?? '';
    lightboxImg.alt = btn.dataset.alt ?? 'Gambar proyek';
    if (lightboxCaption) lightboxCaption.textContent = btn.dataset.caption ?? '';
    if (lightboxCounter) lightboxCounter.textContent = `${current + 1} / ${total}`;
  };

  const openLightbox = (index: number) => {
    if (!lightbox) return;
    render(index);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
    if (lightboxImg) lightboxImg.removeAttribute('src');
  };

  triggers.forEach((btn, index) => {
    btn.addEventListener('click', () => openLightbox(index));
  });

  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => render(current - 1));
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => render(current + 1));

  lightbox?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    // Klik area luar gambar menutup lightbox; klik gambar/nav tidak.
    if (target === lightboxImg || target.closest('button')) return;
    closeLightbox();
  });
  lightboxClose?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') render(current - 1);
    if (e.key === 'ArrowRight') render(current + 1);
  });
</script>
