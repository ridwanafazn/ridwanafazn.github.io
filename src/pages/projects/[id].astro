---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getProjectById, getAllProjects } from '../../lib/content';

const id = Astro.params.id!;
const project = await getProjectById(id);
const notFound = !project;

if (notFound) Astro.response.status = 404;

const base = import.meta.env.BASE_URL;
const projectsLink = `${base.endsWith('/') ? base : base + '/'}projects`;

const pad = (n: number) => String(n).padStart(2, '0');

// Kartu galeri bertinggi tetap (maks 19rem), jadi lebar tampil = rasio gambar.
// Dipakai di `sizes` agar screenshot portrait tidak mengunduh varian 1600px.
const gallerySizes = (image: { width?: number; height?: number }) => {
  const ratio = image.width && image.height ? image.width / image.height : 1.6;
  const cardWidth = Math.min(560, Math.round(304 * ratio));
  return `(min-width: 768px) ${cardWidth}px, 80vw`;
};

type NarrativeSection = { heading: string | null; paragraphs: string[] };

function parseNarrative(text: string): NarrativeSection[] {
  if (!text.trim()) return [];
  return text
    .split(/\n(?=##\s)/g)
    .map((part) => {
      const lines = part.split('\n');
      let heading: string | null = null;
      if (/^##\s/.test((lines[0] ?? '').trim())) {
        heading = lines.shift()!.replace(/^##\s+/, '').trim();
      }
      const paragraphs = lines
        .join('\n')
        .split(/\n\s*\n/)
        .map((paragraph) => paragraph.trim())
        .filter(Boolean);
      return { heading, paragraphs };
    })
    .filter((section) => section.heading || section.paragraphs.length);
}

const narrative = project
  ? parseNarrative(project.longDescription?.trim() || project.description)
  : [];

const gallery = project?.gallery ?? [];
const leadImage = project ? project.coverImage ?? gallery[0]?.url : undefined;
const leadSrcset = project?.coverImage ? undefined : gallery[0]?.srcset;
const gridOffset = project && !project.coverImage && gallery.length > 0 ? 1 : 0;
const sliderImages = gallery
  .slice(gridOffset)
  .map((image, position) => ({ image, index: gridOffset + position }));
const galleryJson = JSON.stringify(
  gallery.map((image, index) => ({
    src: image.url,
    alt: image.alt ?? `${project!.title} — gambar ${index + 1}`,
    caption: image.caption ?? '',
  })),
).replace(/</g, '\\u003c');

const allProjects = project ? await getAllProjects() : [];
const currentIndex = allProjects.findIndex((item) => item.id === project?.id);
const nextProject =
  currentIndex >= 0 && allProjects.length > 1
    ? allProjects[(currentIndex + 1) % allProjects.length]
    : null;
---

{
  notFound || !project ? (
    <Layout title="404 · Ridwan Pages" noindex>
      <div class="mx-auto max-w-xl py-20">
        <p class="font-mono text-[12px] font-bold uppercase tracking-[0.12em] text-accent">404</p>
        <h1 class="mt-4 text-4xl tracking-tight text-on-background">Project tidak ditemukan</h1>
        <a
          href={projectsLink}
          class="group mt-8 inline-flex items-center gap-2 font-mono text-[12px] font-bold uppercase tracking-wider text-on-background underline decoration-outline-strong underline-offset-[6px] transition-colors hover:text-accent"
        >
          <Icon name="arrow-left" class="h-4 w-4" />
          Kembali ke arsip
        </a>
      </div>
    </Layout>
  ) : (
    <Layout
      title={`${project.title} · Ridwan Pages`}
      description={project.description}
      image={project.ogImage ?? project.coverImage}
    >
      <a
        href={projectsLink}
        class="group inline-flex items-center gap-2 font-mono text-[12px] font-bold uppercase tracking-wider text-on-surface-variant transition-colors hover:text-accent"
      >
        <Icon name="arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
        Arsip proyek
      </a>

      <article class="mt-8">
        <header class="reveal from-behind grid gap-8 border-b border-outline-strong pb-8 md:grid-cols-12 md:gap-10 md:pb-10">
          <div class="md:col-span-7">
            <h1 class="text-[clamp(2.5rem,6.5vw,4.25rem)] leading-[1.02] tracking-tight text-on-background">
              {project.title}
            </h1>
            <p class="mt-5 max-w-[56ch] text-[15px] leading-relaxed text-on-surface-variant">
              {project.description}
            </p>
          </div>

          <dl class="grid gap-5 md:col-span-5 md:border-l md:border-outline md:pl-10">
            <div>
              <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Peran</dt>
              <dd class="mt-1 text-[15px] text-on-background">{project.role}</dd>
            </div>
            <div>
              <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Stack</dt>
              <dd class="mt-1 text-[15px] leading-relaxed text-on-background">
                {project.techStack.join(' · ')}
              </dd>
            </div>
            {project.links && project.links.length > 0 && (
              <div>
                <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Tautan</dt>
                <dd class="mt-1 flex flex-col gap-1">
                  {project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex w-fit items-center gap-1.5 text-[15px] text-on-background underline decoration-outline-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                    >
                      {link.label}
                      <Icon name="external-link" class="h-3.5 w-3.5" />
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </header>

        {leadImage && (
          <figure class="reveal mt-8">
            <img
              src={leadImage}
              srcset={leadSrcset}
              sizes="100vw"
              alt={`${project.title} — tampilan utama`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/9] w-full border border-outline bg-surface object-cover"
            />
          </figure>
        )}

        {narrative.map((section) => (
          <section class="reveal grid gap-4 border-t border-outline py-8 md:grid-cols-12 md:gap-8 md:py-10">
            {section.heading ? (
              <h2 class="text-xl tracking-tight text-on-background md:col-span-3 md:sticky md:top-28 md:self-start md:text-2xl">
                {section.heading}
              </h2>
            ) : (
              <h2 class="sr-only">Ringkasan</h2>
            )}
            <div class="max-w-[60ch] space-y-4 text-[15px] leading-relaxed text-on-surface-variant md:col-span-8 md:col-start-5">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>
        ))}

        {gallery.length > 0 && (
          <section class="reveal from-behind border-t border-outline py-8 md:py-10" aria-label="Galeri">
            <div class="flex items-end justify-between gap-4">
              <div>
                <h2 class="text-xl tracking-tight text-on-background md:text-2xl">Galeri</h2>
                <p class="mt-1 text-[12px] text-on-surface-variant">
                  Geser, atau klik gambar untuk memperbesar.
                </p>
              </div>

              <div class="flex shrink-0 items-center gap-2">
                <span class="mr-1 font-mono text-[12px] tabular-nums text-on-surface-variant">
                  {pad(gallery.length)} gambar
                </span>
                <button
                  type="button"
                  data-gallery-prev
                  class="gallery-nav grid h-9 w-9 place-items-center border border-outline bg-surface text-on-surface-variant transition-colors hover:border-on-background hover:bg-on-background hover:text-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  aria-label="Gambar sebelumnya"
                >
                  <Icon name="chevron-left" class="h-[18px] w-[18px]" />
                </button>
                <button
                  type="button"
                  data-gallery-next
                  class="gallery-nav grid h-9 w-9 place-items-center border border-outline bg-surface text-on-surface-variant transition-colors hover:border-on-background hover:bg-on-background hover:text-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  aria-label="Gambar berikutnya"
                >
                  <Icon name="chevron-right" class="h-[18px] w-[18px]" />
                </button>
              </div>
            </div>

            <div
              class="gallery-track mt-6"
              data-gallery
              tabindex="0"
              role="region"
              aria-label="Galeri proyek, geser ke samping"
            >
              {sliderImages.map(({ image, index }) => (
                <figure class="gallery-item group">
                  <button
                    type="button"
                    data-lightbox={index}
                    class="relative block cursor-zoom-in overflow-hidden border border-outline bg-surface transition-colors hover:border-outline-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                    aria-label={`Perbesar gambar ${index + 1}`}
                  >
                    <img
                      src={image.url}
                      srcset={image.srcset}
                      sizes={gallerySizes(image)}
                      width={image.width}
                      height={image.height}
                      alt={image.alt ?? `${project.title} — gambar ${index + 1}`}
                      loading="lazy"
                      decoding="async"
                      class="block transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                    />
                  </button>
                  <figcaption class="mt-2 font-mono text-[12px] tabular-nums text-on-surface-variant">
                    {pad(index + 1)}
                  </figcaption>
                </figure>
              ))}
            </div>

            <div class="mt-4 h-px w-full overflow-hidden bg-outline" aria-hidden="true">
              <span data-gallery-progress class="block h-px bg-on-background/60 transition-[width,transform] duration-200" style="width: 30%"></span>
            </div>
          </section>
        )}

        {project.highlights && project.highlights.length > 0 && (
          <section class="reveal grid gap-3 border-t border-outline py-8 md:grid-cols-12 md:gap-8 md:py-10">
            <ul class="md:col-span-8 md:col-start-5" aria-label="Hasil">
              {project.highlights.map((highlight) => (
                <li class="border-b border-outline py-2.5 text-[14px] leading-snug text-on-background first:pt-0 last:border-b-0">
                  {highlight}
                </li>
              ))}
            </ul>
          </section>
        )}

        {nextProject && (
          <nav class="reveal from-behind border-t border-outline-strong py-8 md:py-10" aria-label="Proyek berikutnya">
            <a href={`${projectsLink}/${nextProject.id}`} class="group flex flex-col gap-2">
              <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">
                Proyek berikutnya
              </span>
              <span class="flex items-baseline justify-between gap-6">
                <span class="font-heading text-3xl leading-tight tracking-tight text-on-background transition-colors group-hover:text-accent md:text-4xl">
                  {nextProject.title}
                </span>
                <Icon
                  name="arrow-right"
                  class="h-6 w-6 shrink-0 text-on-surface-variant transition-all duration-200 group-hover:translate-x-1 group-hover:text-accent"
                />
              </span>
            </a>
          </nav>
        )}
      </article>

      <Fragment slot="overlay">
        {gallery.length > 0 && (
          <div
            id="lightbox"
            class="fixed inset-0 z-[100] hidden items-center justify-center bg-on-background/95 p-4"
            role="dialog"
            aria-modal="true"
            aria-label="Gambar diperbesar"
            tabindex="-1"
          >
            <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 p-4 md:p-6">
              <span
                id="lightbox-counter"
                class="border border-white/20 px-3 py-1 font-mono text-[12px] tabular-nums tracking-[0.12em] text-white"
              >
                1 / 1
              </span>
              <button
                type="button"
                id="lightbox-close"
                class="grid h-10 w-10 place-items-center border border-white/25 text-white transition-colors duration-150 hover:bg-white hover:text-on-background"
                aria-label="Tutup gambar"
              >
                <Icon name="close" class="h-5 w-5" />
              </button>
            </div>

            <button
              type="button"
              data-lightbox-prev
              class="absolute left-2 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center border border-white/25 bg-on-background/60 text-white transition-colors duration-150 hover:bg-white hover:text-on-background md:left-6"
              aria-label="Gambar sebelumnya"
            >
              <Icon name="chevron-left" class="h-5 w-5" />
            </button>
            <button
              type="button"
              data-lightbox-next
              class="absolute right-2 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center border border-white/25 bg-on-background/60 text-white transition-colors duration-150 hover:bg-white hover:text-on-background md:right-6"
              aria-label="Gambar berikutnya"
            >
              <Icon name="chevron-right" class="h-5 w-5" />
            </button>

            <figure class="flex max-h-[88vh] w-full max-w-5xl flex-col items-center gap-3 px-1 md:px-10">
              <img
                id="lightbox-img"
                src={gallery[0]?.url}
                alt=""
                loading="lazy"
                class="max-h-[70vh] max-w-full object-contain md:max-h-[76vh]"
              />
              <figcaption
                id="lightbox-caption"
                class="max-w-full truncate text-center font-mono text-[12px] uppercase tracking-[0.12em] text-white/70"
              >
              </figcaption>
            </figure>
          </div>
        )}
      </Fragment>
    </Layout>
  )
}

<script type="application/json" id="gallery-data" set:html={galleryJson} />

<script>
  const dataEl = document.getElementById('gallery-data');
  const items: { src: string; alt: string; caption: string }[] = dataEl
    ? JSON.parse(dataEl.textContent || '[]')
    : [];

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxClose = document.getElementById('lightbox-close');
  let current = 0;
  let lastTrigger: HTMLElement | null = null;

  // Konten di belakang dialog tidak boleh menerima fokus/klik.
  const setPageInert = (on: boolean) => {
    ['header', 'main', 'footer'].forEach((selector) => {
      const el = document.querySelector(selector);
      if (!el) return;
      if (on) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });
  };

  const lightboxFocusables = (): HTMLElement[] => {
    if (!lightbox) return [];
    return Array.from(
      lightbox.querySelectorAll<HTMLElement>('button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
    ).filter((el) => el.offsetParent !== null);
  };

  const render = (index: number) => {
    const total = items.length;
    if (!lightboxImg || !total) return;
    current = (index + total) % total;
    const item = items[current];
    lightboxImg.src = item.src;
    lightboxImg.alt = item.alt;
    if (lightboxCaption) lightboxCaption.textContent = item.caption || `${current + 1} / ${total}`;
    if (lightboxCounter) lightboxCounter.textContent = `${current + 1} / ${total}`;
  };

  const openLightbox = (index: number) => {
    if (!lightbox) return;
    lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    render(index);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    setPageInert(true);
    lightboxClose?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
    setPageInert(false);
    if (lastTrigger && lastTrigger.isConnected) lastTrigger.focus();
    lastTrigger = null;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => openLightbox(Number(btn.dataset.lightbox ?? 0)));
  });

  // Slider galeri: satu kartu per langkah, berhenti di ujung (Play Store style).
  const track = document.querySelector<HTMLElement>('[data-gallery]');
  const galleryPrev = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const galleryNext = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const galleryProgress = document.querySelector<HTMLElement>('[data-gallery-progress]');

  if (track) {
    // Kartu punya lebar berbeda (rasio asli), jadi lompat ke kartu berikutnya
    // berdasarkan posisi kontennya, bukan lebar kartu pertama.
    const step = (direction: number) => {
      const box = track.getBoundingClientRect();
      const left = track.scrollLeft;
      const offsets = Array.from(track.querySelectorAll<HTMLElement>('.gallery-item')).map(
        (item) => item.getBoundingClientRect().left - box.left + left,
      );
      const target =
        direction > 0
          ? offsets.find((offset) => offset > left + 4)
          : [...offsets].reverse().find((offset) => offset < left - 4);
      track.scrollTo({
        left: target ?? (direction > 0 ? track.scrollWidth : 0),
        behavior: 'smooth',
      });
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (galleryPrev) galleryPrev.disabled = track.scrollLeft <= 2;
      if (galleryNext) galleryNext.disabled = track.scrollLeft >= max - 2;
      if (galleryProgress) {
        const ratio = track.scrollWidth > 0 ? track.clientWidth / track.scrollWidth : 1;
        galleryProgress.style.width = `${Math.min(100, ratio * 100)}%`;
        const travel =
          max > 0 && ratio < 1 ? (track.scrollLeft / max) * ((1 - ratio) / ratio) * 100 : 0;
        galleryProgress.style.transform = `translateX(${travel}%)`;
      }
    };

    galleryPrev?.addEventListener('click', () => step(-1));
    galleryNext?.addEventListener('click', () => step(1));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });
    sync();
  }

  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => render(current - 1));
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => render(current + 1));

  lightbox?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === lightboxImg || target.closest('button')) return;
    closeLightbox();
  });
  lightboxClose?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeLightbox();
      return;
    }
    if (event.key === 'ArrowLeft') render(current - 1);
    if (event.key === 'ArrowRight') render(current + 1);

    if (event.key === 'Tab') {
      const focusables = lightboxFocusables();
      if (!focusables.length) {
        event.preventDefault();
        lightbox.focus();
        return;
      }

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || active === lightbox)) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });
</script>
