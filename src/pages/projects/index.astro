---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ProjectLedger from '../../components/ProjectLedger.astro';
import { getAllProjects } from '../../lib/content';

const allProjects = await getAllProjects();
---

<Layout
  title="Project Vault · Ridwan Pages"
  description={`Arsip ${allProjects.length} proyek: sistem backend, aplikasi fullstack, dan platform produksi.`}
  image="/og.png"
>
  <header class="reveal mb-10 md:mb-14">
    <h1 class="text-[clamp(2.5rem,7.5vw,4rem)] leading-[1.02] tracking-tight text-on-background">
      Portofolio Proyek
    </h1>
    <p class="mt-5 max-w-[62ch] text-[15px] leading-relaxed text-on-surface-variant md:text-lg">
      Kumpulan sistem, aplikasi, dan arsitektur yang sudah dibangun — mulai dari backend low-latency,
      fullstack monolitik, sampai sistem terdistribusi skala produksi.
    </p>
  </header>

  <div class="flex items-baseline justify-between border-b border-outline-strong pb-3">
    <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Arsip</span>
    <span class="font-mono text-[12px] tabular-nums text-on-surface-variant">
      {allProjects.length} proyek
    </span>
  </div>

  <ProjectLedger projects={allProjects} />
  {allProjects.length === 0 && (
    <p class="border-b border-outline py-10 text-[14px] text-on-surface-variant">
      Belum ada proyek yang dipublikasikan. Kembali lagi nanti.
    </p>
  )}
</Layout>
