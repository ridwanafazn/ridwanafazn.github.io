---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projectsData from '../../data/projects.json';
import type { Project } from '../../types';

const allProjects = projectsData as Project[];
---

<Layout title="Project Vault">
  <header class="pt-0 mb-16 relative z-10">
    <h1 class="text-5xl md:text-6xl font-bold text-on-background mb-6 tracking-tight">Portofolio Proyek</h1>
    <p class="text-lg text-on-surface-variant max-w-2xl leading-relaxed text-justify">
      Kumpulan sistem, aplikasi, dan arsitektur yang sudah dibangun — mulai dari backend low-latency, fullstack monolitik, sampai sistem terdistribusi skala produksi.
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 relative z-10 mb-16">
    {allProjects.map((project, i) => {
      const delay = i % 3 === 1 ? 'reveal-delay-1' : i % 3 === 2 ? 'reveal-delay-2' : '';
      return (
        <div class={`h-full reveal ${delay}`}>
          <ProjectCard project={project} />
        </div>
      );
    })}
  </div>
</Layout>