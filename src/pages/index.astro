---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import FloatingNav from '../components/FloatingNav.astro';
import HowIBuild from '../components/HowIBuild.astro';
import HeroGlobe from '../components/HeroGlobe.astro';
import ProjectLedger from '../components/ProjectLedger.astro';
import Icon from '../components/Icon.astro';

import { getProfile, getTopProjects, getSkills } from '../lib/content';

const profileData = await getProfile();
const topProjects = await getTopProjects();
const skillsData = await getSkills();
const base = import.meta.env.BASE_URL;
const projectsLink = `${base.endsWith('/') ? base : base + '/'}projects`;

const since = profileData.stats.find((stat) => /professional/i.test(stat.label))?.value ?? '—';
// Label ringkas khusus hero — bukan nama kategori DB (itu tetap dipakai di section Tech Stack).
const stackSummary = ['FE', 'BE', 'Cloud', 'Mobile', 'AI', 'ML'].join('·');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profileData.name,
  jobTitle: profileData.role,
  description: profileData.bio,
  url: (Astro.site ?? new URL('https://ridwanafazn.my.id')).href,
  email: 'mailto:ridwanafzn@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/ridwanafazn/',
    'https://github.com/ridwanafazn',
    'https://www.instagram.com/ridwanafazn/',
  ],
};
---

<Layout
  title="Ridwan Pages"
  description={`${profileData.role} — ${profileData.tagline} Portofolio sistem produksi: LMS, ledger, dan platform event.`}
  image="/og.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} />
  <FloatingNav />

  <header id="hero" class="relative mb-14 md:mb-20 scroll-mt-32">
    <HeroGlobe />

    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <h1 class="font-bold text-[clamp(2.75rem,9vw,4.75rem)] leading-[0.98] tracking-tight text-on-background opacity-0 animate-[fadeSlideUp_0.6s_cubic-bezier(0.22,1,0.36,1)_0.1s_forwards]">
          {profileData.role}.
        </h1>

        <p class="mt-6 max-w-[34ch] text-xl leading-snug text-on-surface-variant md:text-2xl opacity-0 animate-[fadeSlideUp_0.6s_cubic-bezier(0.22,1,0.36,1)_0.25s_forwards]">
          {profileData.tagline}
        </p>

        <p class="mt-6 hidden max-w-[56ch] text-[15px] leading-relaxed text-on-surface-variant md:block opacity-0 animate-[fadeSlideUp_0.6s_cubic-bezier(0.22,1,0.36,1)_0.35s_forwards]">
          {profileData.bio}
        </p>

        <div class="mt-9 flex items-stretch opacity-0 animate-[fadeSlideUp_0.6s_cubic-bezier(0.22,1,0.36,1)_0.45s_forwards]">
          <a
            href="mailto:ridwanafzn@gmail.com"
            class="inline-flex items-center justify-center gap-2 border border-on-background bg-on-background px-4 py-3.5 font-mono text-[12px] font-bold uppercase tracking-wider text-background transition-colors duration-200 hover:border-accent hover:bg-accent md:px-7"
          >
            Contact Me
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href={projectsLink}
            class="group inline-flex items-center justify-center gap-2 border border-l-0 border-on-background px-4 py-3.5 font-mono text-[12px] font-bold uppercase tracking-wider text-on-background transition-colors duration-200 hover:bg-on-background hover:text-background md:px-7"
          >
            Project List
            <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </div>

      <!-- Ruang globe di desktop; komponen HeroGlobe dirender absolut di sini -->
      <div class="hidden lg:block lg:col-span-5 lg:h-[440px]" aria-hidden="true"></div>
    </div>
  </header>

  <section aria-label="Ringkasan profil" class="mb-16 md:mb-20">
    <dl class="grid grid-cols-2 gap-px bg-outline md:grid-cols-4">
      <div class="spec-cell min-w-0 bg-background p-5 md:p-6">
        <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Fokus</dt>
        <dd class="mt-2 text-[15px] leading-snug text-on-background">{profileData.currentFocus.title}</dd>
      </div>
      <div class="spec-cell min-w-0 bg-background p-5 md:p-6">
        <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Sejak</dt>
        <dd class="mt-2 font-mono text-[15px] tabular-nums text-on-background">{since}</dd>
      </div>
      <div class="spec-cell col-span-2 min-w-0 bg-background p-5 md:col-span-1 md:p-6">
        <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Stack</dt>
        <dd class="mt-2 font-mono text-[12px] uppercase tracking-normal text-on-background">{stackSummary}</dd>
      </div>
      <div class="spec-cell col-span-2 min-w-0 bg-background p-5 pr-12 md:col-span-1 md:p-6">
        <dt class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">Kontak</dt>
        <dd class="mt-2 text-[13px] md:text-[15px]">
          <a
            href="mailto:ridwanafzn@gmail.com"
            class="break-all text-on-background underline decoration-outline-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
          >
            ridwanafzn@gmail.com
          </a>
        </dd>
      </div>
    </dl>
  </section>

  <section id="projects" class="mb-16 md:mb-20 relative z-10 scroll-mt-32">
    <div class="reveal mb-2 flex items-end justify-between gap-4 border-b border-outline-strong pb-4">
      <h2 class="text-3xl text-on-background tracking-tight md:text-4xl">Featured Projects</h2>

      <a
        href={projectsLink}
        class="group flex shrink-0 items-center gap-1.5 font-mono text-[12px] font-bold uppercase tracking-wider text-accent transition-colors hover:text-accent-hover"
      >
        Lihat Semua
        <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    <ProjectLedger projects={topProjects} showIndex={false} showStack={false} />
    {topProjects.length === 0 && (
      <p class="border-b border-outline py-6 text-[14px] text-on-surface-variant">
        Belum ada proyek yang dipublikasikan.
      </p>
    )}
  </section>

  <section id="skills" class="mb-16 md:mb-20 relative z-10 scroll-mt-32">
    <div class="reveal mb-2 flex items-end justify-between border-b border-outline-strong pb-4">
      <h2 class="text-3xl text-on-background tracking-tight md:text-4xl">Tech Stack</h2>
      <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-on-surface-variant">
        {skillsData.length} kategori
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2">
      {skillsData.length === 0 && (
        <p class="border-b border-outline py-6 text-[14px] text-on-surface-variant md:col-span-2">
          Belum ada data keahlian.
        </p>
      )}
      {skillsData.map((skillGroup, i) => (
        <div class={`reveal border-b border-outline py-6 md:py-7 ${i % 2 === 0 ? 'from-left md:pr-8' : 'from-right md:border-l md:border-outline md:pl-8'} ${i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : i === 3 ? 'reveal-delay-3' : ''}`}>
          <h3 class="mb-4 font-mono text-[12px] font-bold uppercase tracking-[0.12em] text-on-surface-variant">
            {skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skillGroup.items.map((item) => (
              <Badge text={item} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16 md:mb-20 relative z-10">
    <div class="reveal from-behind grid gap-6 border-y border-outline py-8 md:grid-cols-12 md:gap-10 md:py-10">
      <h2 class="text-2xl tracking-tight text-on-background md:col-span-4 md:text-3xl">
        {profileData.currentFocus.title}
      </h2>
      <p class="max-w-[62ch] text-[15px] leading-relaxed text-on-surface-variant md:col-span-8">
        {profileData.currentFocus.description}
      </p>
    </div>
  </section>

  <HowIBuild data={profileData.howIBuild} />
</Layout>
