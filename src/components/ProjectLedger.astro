---
// src/components/ProjectLedger.astro
import type { Project } from '../types';
import Icon from './Icon.astro';
import ProjectTrail from './ProjectTrail';

interface Props {
  projects: Project[];
  /** Tampilkan nomor indeks arsip (01, 02, …). Matikan di homepage. */
  showIndex?: boolean;
  /** Tampilkan kolom stack. Homepage hanya menampilkan role. */
  showStack?: boolean;
}

const { projects, showIndex = true, showStack = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (id: string) => `${base.endsWith('/') ? base : base + '/'}projects/${id}`;
const pad = (n: number) => String(n).padStart(2, '0');

// Stack hanya muncul di lg supaya kolom role punya ruang di tablet.
const rowGrid = showIndex
  ? showStack
    ? 'grid-cols-[1.5rem_1fr_1.25rem] md:grid-cols-[2.25rem_4.5rem_minmax(0,1fr)_minmax(0,11rem)_1.25rem] lg:grid-cols-[2.25rem_5rem_minmax(0,1fr)_minmax(0,13rem)_minmax(0,14rem)_1.25rem]'
    : 'grid-cols-[1.5rem_1fr_1.25rem] md:grid-cols-[2.25rem_4.5rem_minmax(0,1fr)_minmax(0,11rem)_1.25rem] lg:grid-cols-[2.25rem_5rem_minmax(0,1fr)_minmax(0,13rem)_1.25rem]'
  : showStack
    ? 'grid-cols-[1fr_1.25rem] md:grid-cols-[4.5rem_minmax(0,1fr)_minmax(0,11rem)_1.25rem] lg:grid-cols-[5rem_minmax(0,1fr)_minmax(0,13rem)_minmax(0,14rem)_1.25rem]'
    : 'grid-cols-[1fr_1.25rem] md:grid-cols-[4.5rem_minmax(0,1fr)_minmax(0,11rem)_1.25rem] lg:grid-cols-[5rem_minmax(0,1fr)_minmax(0,13rem)_1.25rem]';
---

<ul class="reveal">
  {
    projects.map((project, index) => (
      <li>
        <a
          href={href(project.id)}
          data-preview={project.previewImage}
          class:list={[
            'group grid items-center gap-x-4 gap-y-1 border-b border-outline py-2.5 transition-colors hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent md:gap-x-5',
            rowGrid,
          ]}
        >
          {showIndex && (
            <span class="font-mono text-[12px] tabular-nums text-on-surface-variant" aria-hidden="true">
              {pad(index + 1)}
            </span>
          )}

          <span
            class="hidden h-11 w-[4.5rem] items-center justify-center overflow-hidden border border-outline bg-surface md:flex"
            aria-hidden="true"
          >
            {project.previewImage ? (
              <img
                src={project.previewImage}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <span class="font-mono text-[12px] text-on-surface-variant/60">—</span>
            )}
          </span>

          <span class="min-w-0">
            <span
              class="block font-heading text-lg leading-snug tracking-tight text-on-background transition-colors group-hover:text-accent md:text-xl md:leading-tight"
            >
              {project.title}
            </span>
            <span class="mt-0.5 block text-[12px] leading-snug text-on-surface-variant md:hidden">
              {project.role}
            </span>
          </span>

          <span
            class="hidden min-w-0 text-[13px] leading-snug text-on-surface-variant md:line-clamp-2"
            title={project.role}
          >
            {project.role}
          </span>

          {showStack && (
            <span
              class="hidden min-w-0 items-baseline gap-1 font-mono text-[12px] text-on-surface-variant lg:flex"
              title={project.techStack.join(' · ')}
            >
              {/* Ringkas: 2 item pertama + jumlah sisanya. Detail lengkap ada di halaman project. */}
              <span class="min-w-0 truncate">{project.techStack.slice(0, 2).join(' · ')}</span>
              {project.techStack.length > 2 && (
                <span class="shrink-0 tabular-nums">+{project.techStack.length - 2}</span>
              )}
            </span>
          )}

          <Icon
            name="arrow-right"
            class="h-4 w-4 justify-self-end text-on-surface-variant transition-all duration-200 group-hover:translate-x-1 group-hover:text-signal"
          />
        </a>
      </li>
    ))
  }
</ul>

<ProjectTrail client:media="(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)" />
