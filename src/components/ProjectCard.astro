---
import type { Project } from '../types';
import Badge from './Badge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const projectLink = `${base.endsWith('/') ? base : base + '/'}projects/${project.id}`;
---

<a href={projectLink} class="bento-card group flex flex-col p-6 md:p-8 min-h-[280px] h-full relative outline-none focus-visible:ring-2 focus-visible:ring-accent block reveal from-behind">
  
  <div class="absolute top-8 right-8 opacity-0 group-hover:opacity-100 transform translate-x-4 -translate-y-4 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 z-10 bg-surface border border-outline rounded-md p-2 flex items-center justify-center">
    <span class="material-symbols-outlined text-[18px] text-on-surface-variant group-hover:text-accent transition-colors">arrow_forward</span>
  </div>

  <div class="relative z-10 flex flex-col h-full flex-grow">
    
    <div class="flex justify-between items-start mb-4 pr-10">
      <span class="font-mono text-[9px] font-bold tracking-widest text-on-surface-variant flex items-center gap-2 uppercase">
        <span class="w-1 h-1 rounded-full bg-outline-strong"></span>
        {project.role}
      </span>
      
      <div class="flex items-center gap-2">
        {project.status && (
          <span class="font-mono text-[8px] uppercase tracking-widest font-bold px-2 py-0.5 bg-accent/10 text-accent border border-accent/25 rounded-md">
            {project.status}
          </span>
        )}
        {project.isTopProject && (
          <div class="flex items-center justify-center" title="Proyek Unggulan">
            <div class="h-1.5 w-1.5 rounded-full bg-accent"></div>
          </div>
        )}
      </div>
    </div>

    <div class="flex-grow flex flex-col mt-2">
      <h3 class="text-2xl font-bold text-on-background mb-2 group-hover:text-accent transition-colors duration-300 tracking-tight">
        {project.title}
      </h3>
      <p class="text-on-surface-variant text-[13px] leading-relaxed mb-4 font-medium text-justify">
        {project.description}
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mt-auto pt-4">
      {project.techStack.map((tech) => (
        <Badge text={tech} />
      ))}
    </div>
    
  </div>
</a>
