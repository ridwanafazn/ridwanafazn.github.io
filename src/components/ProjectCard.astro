---
import type { Project } from '../types';
import Badge from './Badge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const projectLink = `${base.endsWith('/') ? base : base + '/'}projects/${project.id}`;
const maxTech = 3;
const visibleTech = project.techStack.slice(0, maxTech);
const extraTech = project.techStack.length - visibleTech.length;
---

<a
  href={projectLink}
  class="bento-card group flex h-full flex-col overflow-hidden outline-none transition-all duration-300 reveal from-behind hover:-translate-y-1 focus-visible:ring-2 focus-visible:ring-accent"
>
  {
    project.coverImage && (
      <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-outline">
        <img
          src={project.coverImage}
          alt={project.title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      </div>
    )
  }

  <div class="relative flex flex-1 flex-col p-6 md:p-7">
    <div
      class="absolute right-6 top-6 z-10 flex items-center justify-center rounded-md border border-outline bg-surface p-2 opacity-0 transition-all duration-300 group-hover:opacity-100 md:right-7 md:top-7"
    >
      <span class="material-symbols-outlined text-[18px] text-on-surface-variant transition-colors group-hover:text-accent">
        arrow_forward
      </span>
    </div>

    <div class="mb-4 pr-10">
      <span class="font-mono text-[9px] font-bold uppercase tracking-widest text-on-surface-variant">
        {project.role}
      </span>
    </div>

    <div class="mt-2 flex flex-grow flex-col">
      <h3 class="mb-2 text-2xl font-bold tracking-tight text-on-background transition-colors duration-300 group-hover:text-accent">
        {project.title}
      </h3>
      <p class="mb-4 text-left text-[13px] font-medium leading-relaxed text-on-surface-variant md:text-justify">
        {project.description}
      </p>
    </div>

    <div class="mt-auto flex flex-wrap gap-2 pt-4">
      {visibleTech.map((tech) => <Badge text={tech} />)}
      {
        extraTech > 0 && (
          <span class="rounded border border-outline px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            +{extraTech}
          </span>
        )
      }
    </div>
  </div>
</a>
