---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<header class:list={['reveal mb-10 md:mb-14', className]}>
  <h1 class="page-title text-on-background">{title}</h1>
  {description && (
    <p class="mt-5 max-w-[62ch] text-[15px] leading-relaxed text-on-surface-variant md:text-lg">
      {description}
    </p>
  )}
</header>
