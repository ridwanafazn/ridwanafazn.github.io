---
import SfxSpark from './SfxSpark';

interface Props {
  role: string;
  tagline: string;
}

const { role, tagline } = Astro.props;

const roleLines = role.split(/\s+/).filter(Boolean);
const [taglineLead, ...taglineRest] = tagline.split(',');
const taglineTail = taglineRest.join(',').trim();

const marqueeItems = [
  role.toUpperCase(),
  'AI APPLICATION ENGINEER',
  'KEEP IT SIMPLE',
  'MAKE IT SCALE',
  'LEDGER',
  'LMS',
  'EVENT PLATFORM',
];
---

<header class="hero-root" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-plane-red"></div>
    <div class="hero-outline-word">SCALE</div>
    <div class="hero-grid"></div>
    <div class="hero-plane-lime"></div>
    <div class="hero-cross hero-cross-a"></div>
    <div class="hero-cross hero-cross-b"></div>
  </div>

  <div class="hero-stage">
    <div class="hero-copy">
      <h1 class="hero-headline">
        {roleLines.map((line, index) => (
          <span class="hero-line" data-text={line} style={`animation-delay: ${0.06 + index * 0.08}s`}>{line}</span>
        ))}
      </h1>

      <p class="hero-subtext">
        {taglineLead}{taglineTail && <>, <em>{taglineTail}</em></>}
      </p>

      <div class="hero-quote" aria-hidden="true">
        <i class="hero-quote-mark" aria-hidden="true"></i>
        <div class="hero-quote-lines">
          <p class="hero-quote-ja" lang="ja"></p>
          <p class="hero-quote-en" lang="en"></p>
        </div>
      </div>
    </div>

    <div class="hero-portrait">
      <div class="hero-portrait-layer hero-portrait-base">
        <picture>
          <source srcset="/images/ridwan-cutout.webp" type="image/webp" />
          <img
            src="/images/ridwan-cutout.png"
            alt="Ridwan Afazn memakai kemeja batik hitam, melihat ke arah salinan di kiri."
            width="1086"
            height="1448"
            fetchpriority="high"
          />
        </picture>
      </div>

      <div class="hero-portrait-layer hero-portrait-reveal" aria-hidden="true">
        <img
          src="/images/rengoku.webp"
          alt=""
          width="900"
          height="1200"
          decoding="async"
          fetchpriority="low"
        />
      </div>

      <button class="hero-sfx" type="button" aria-pressed="false" aria-label="SFX OFF — aktifkan efek suara api">
        <i aria-hidden="true"></i>
        <span class="hero-sfx-label">SFX OFF</span>
      </button>

      <!-- SFX: Mixkit "Fire woosh" (ID 1348), Mixkit Free License. -->
      <audio class="hero-sfx-audio" src="/audio/fire-whoosh.mp3" preload="none" aria-hidden="true"></audio>
    </div>

    <div class="hero-app-wrap">
      <figure class="hero-app-frame" aria-label="GIS Sentry, aplikasi pemetaan lokasi minimarket">
        <div class="hero-app-bar">
          <span class="hero-app-dot" aria-hidden="true"></span>
          <span class="hero-app-dot" aria-hidden="true"></span>
          <span class="hero-app-dot" aria-hidden="true"></span>
          <span class="hero-app-url">gis-sentry / overview</span>
          <span class="hero-app-live"><i aria-hidden="true"></i>LIVE</span>
        </div>
        <div class="hero-app-shot">
          <img
            src="https://res.cloudinary.com/a5e2n4lq/image/upload/c_limit,w_1200,q_auto,f_auto/portfolio/gallery-01-map-1600x1000"
            alt="GIS Sentry menampilkan peta skor lokasi, kandidat minimarket, dan panel analisis."
            width="1600"
            height="1000"
            loading="eager"
          />
          <svg class="hero-app-cursor" viewBox="0 0 24 28" aria-hidden="true">
            <path d="M2 1l18 12-8 2-3 8L2 1z" fill="currentColor" stroke="#080907" stroke-width="1.4"></path>
          </svg>
        </div>
      </figure>
    </div>
  </div>

  <div class="hero-marquee" aria-hidden="true">
    <div class="hero-marquee-track" data-impeccable-ignore="marquee">
      {marqueeItems.map((item) => (
        <>
          <span>{item}</span>
          <i class="hero-marquee-mark" aria-hidden="true"></i>
        </>
      ))}
      {marqueeItems.map((item) => (
        <>
          <span>{item}</span>
          <i class="hero-marquee-mark" aria-hidden="true"></i>
        </>
      ))}
    </div>
  </div>

  <div class="hero-noise" aria-hidden="true"></div>

  <SfxSpark client:media="(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)" />
</header>

<style>
  .hero-root {
    --hero-ink: #080907;
    --hero-paper: #f3f5f1;
    --hero-paper-dim: #a9afa5;
    --hero-red: #d9480f;
    --hero-lime: #c8ff3d;
    --hero-line: rgba(243, 245, 241, 0.16);
    --hero-pad: 48px;

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100vw;
    min-height: 100svh;
    margin-right: calc(50% - 50vw);
    margin-bottom: var(--hero-bottom-gap);
    margin-left: calc(50% - 50vw);
    overflow: clip;
    background: var(--hero-ink);
    color: var(--hero-paper);
    font-family: var(--font-sans);
    cursor: crosshair;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(243, 245, 241, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(243, 245, 241, 0.05) 1px, transparent 1px);
    background-size: 88px 88px;
    /* Geser 1px supaya garis grid tidak jatuh tepat di tepi kiri (tampak seperti celah putih). */
    background-position: -1px 0;
    mask-image: linear-gradient(to bottom, black, transparent 84%);
  }

  .hero-plane-red {
    position: absolute;
    left: 34%;
    top: 0;
    z-index: 0;
    width: 32%;
    height: 96%;
    background: var(--hero-red);
    clip-path: polygon(0 6%, 100% 0, 100% 94%, 8% 100%);
    transform: skewY(-3deg);
    opacity: 0.96;
  }

  .hero-plane-red::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--hero-lime);
    opacity: 0.8;
  }

  .hero-plane-red::after {
    content: '';
    position: absolute;
    left: 6%;
    right: 4%;
    top: 36%;
    height: 1px;
    background: rgba(243, 245, 241, 0.24);
  }

  .hero-outline-word {
    position: absolute;
    left: -3%;
    bottom: 2%;
    z-index: 1;
    color: transparent;
    font-family: var(--font-heading);
    font-size: clamp(8rem, 16vw, 16rem);
    font-weight: 600;
    line-height: 0.78;
    letter-spacing: -0.06em;
    white-space: nowrap;
    -webkit-text-stroke: 1px rgba(243, 245, 241, 0.16);
    transform: rotate(-4deg);
  }

  .hero-plane-lime {
    position: absolute;
    left: 54%;
    top: -4%;
    z-index: 1;
    width: 2px;
    height: 112%;
    background: var(--hero-lime);
    opacity: 0.82;
    transform: rotate(8deg);
    transform-origin: top center;
  }

  .hero-cross {
    position: absolute;
    width: 20px;
    height: 20px;
    opacity: 0.5;
  }

  .hero-cross::before,
  .hero-cross::after {
    content: '';
    position: absolute;
    background: var(--hero-paper);
  }

  .hero-cross::before {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }

  .hero-cross::after {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }

  .hero-cross-a {
    left: 7%;
    top: 22%;
  }

  .hero-cross-b {
    right: 9%;
    bottom: 22%;
    width: 13px;
    height: 13px;
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    z-index: 30;
    pointer-events: none;
    opacity: 0.07;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
  }

  .hero-stage {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 0;
  }

  .hero-copy {
    position: absolute;
    left: var(--hero-pad);
    top: 35%;
    z-index: 14;
    width: min(36vw, 480px);
    max-width: 480px;
    padding: 0;
  }

  .hero-headline {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(3.8rem, 6vw, 6.2rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-wrap: initial;
  }

  .hero-line {
    position: relative;
    display: block;
    width: max-content;
    max-width: 100%;
    animation: hero-line-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-line::before {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    z-index: -1;
    color: var(--hero-red);
    opacity: 0.4;
    transform: translate(4px, 3px);
    pointer-events: none;
  }

  @keyframes hero-line-in {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.2em) rotate(1deg);
      opacity: 0;
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: none;
      opacity: 1;
    }
  }

  .hero-subtext {
    max-width: 34ch;
    margin: 20px 0 0;
    color: var(--hero-paper-dim);
    font-size: clamp(1.05rem, 1.35vw, 1.35rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .hero-subtext em {
    color: var(--hero-lime);
    font-family: inherit;
    font-size: 1em;
    font-style: normal;
    font-weight: 500;
    letter-spacing: inherit;
  }

  .hero-portrait {
    --hero-spot-x: 50%;
    --hero-spot-y: 50%;

    position: absolute;
    left: 50%;
    bottom: -18px;
    z-index: 10;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: min(40vw, 580px);
    height: 96%;
    max-height: 790px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero-portrait-layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-portrait-layer picture {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
  }

  .hero-portrait-layer img {
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
    max-height: 790px;
    object-fit: contain;
    object-position: bottom center;
    mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
  }

  /* Foto asli selalu menjadi lapisan dasar dan terlihat penuh. */
  .hero-portrait-base {
    z-index: 1;
  }

  .hero-portrait-base img {
    filter:
      drop-shadow(-16px 0 0 rgba(217, 72, 15, 0.72))
      drop-shadow(9px 0 0 rgba(200, 255, 61, 0.16))
      drop-shadow(0 30px 40px rgba(0, 0, 0, 0.55));
  }

  /* Rengoku hanya muncul di dalam blob lembut saat kursor menyorot foto. */
  .hero-portrait-reveal {
    z-index: 2;
    opacity: 0;
    -webkit-mask-image: url('/images/reveal-blob.png');
    mask-image: url('/images/reveal-blob.png');
    -webkit-mask-size: 320px 360px;
    mask-size: 320px 360px;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: calc(var(--hero-spot-x) - 160px) calc(var(--hero-spot-y) - 180px);
    mask-position: calc(var(--hero-spot-x) - 160px) calc(var(--hero-spot-y) - 180px);
    transition: opacity 0.18s ease;
  }

  .hero-root.is-spotting .hero-portrait-reveal {
    opacity: 1;
  }

  .hero-quote {
    position: absolute;
    left: 0;
    top: calc(100% + 40px);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: min(100%, 360px);
    max-width: 360px;
    opacity: 0;
    transition: opacity 0.18s ease;
    pointer-events: none;
  }

  .hero-root.is-spotting.is-quoting .hero-quote {
    opacity: 1;
  }

  .hero-quote-mark {
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    margin-top: 8px;
    background: var(--hero-lime);
    transform: rotate(45deg);
  }

  .hero-quote-lines {
    min-width: 0;
    text-wrap: pretty;
  }

  .hero-quote-ja {
    margin: 0;
    color: var(--hero-paper);
    font-family: 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', 'Noto Sans CJK JP', sans-serif;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-shadow: 0 2px 12px rgba(8, 9, 7, 0.8);
  }

  .hero-quote-en {
    margin: 5px 0 0;
    color: rgba(243, 245, 241, 0.78);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(8, 9, 7, 0.85);
  }

  .hero-sfx {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 6;
    display: none;
    align-items: center;
    gap: 7px;
    padding: 5px 9px;
    min-height: 24px;
    border: 1px solid var(--hero-line);
    border-radius: 0;
    background: rgba(8, 9, 7, 0.35);
    color: var(--hero-paper-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .hero-root.is-spot-ready .hero-sfx {
    display: inline-flex;
  }

  .hero-sfx:hover,
  .hero-sfx:focus-visible {
    color: var(--hero-paper);
    border-color: rgba(243, 245, 241, 0.4);
  }

  .hero-sfx i {
    display: block;
    width: 5px;
    height: 5px;
    background: var(--hero-paper-dim);
    transform: rotate(45deg);
    transition: background 0.18s ease;
  }

  .hero-sfx.is-on {
    color: var(--hero-lime);
    border-color: rgba(200, 255, 61, 0.45);
  }

  .hero-sfx.is-on i {
    background: var(--hero-lime);
  }

  .hero-app-wrap {
    position: absolute;
    right: 2%;
    top: 30%;
    z-index: 12;
    width: min(34vw, 470px);
    max-width: 470px;
    perspective: 1200px;
    animation: hero-app-float 7s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hero-app-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .hero-app-frame {
    position: relative;
    overflow: visible;
    margin: 0;
    border: 1px solid rgba(243, 245, 241, 0.22);
    background: #0c0d0a;
    box-shadow:
      18px 18px 0 rgba(217, 72, 15, 0.88),
      0 38px 80px rgba(0, 0, 0, 0.55);
    transform: rotateY(-12deg) rotateX(5deg) rotateZ(-3deg);
    transform-style: preserve-3d;
  }

  .hero-app-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 10px;
    border-bottom: 1px solid rgba(243, 245, 241, 0.12);
    background: #080907;
    color: var(--hero-paper-dim);
    font-size: 10px;
  }

  .hero-app-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hero-red);
  }

  .hero-app-dot:nth-child(2) {
    background: var(--hero-lime);
  }

  .hero-app-dot:nth-child(3) {
    background: var(--hero-paper-dim);
  }

  .hero-app-url {
    margin-left: 6px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hero-app-live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
    color: var(--hero-lime);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .hero-app-live i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hero-lime);
  }

  .hero-app-shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f6f7f6;
  }

  .hero-app-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: saturate(0.9) contrast(1.04);
  }

  .hero-app-shot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(217, 72, 15, 0.06), rgba(8, 9, 7, 0.16));
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .hero-app-cursor {
    position: absolute;
    left: 57%;
    top: 51%;
    z-index: 2;
    width: 24px;
    height: 28px;
    color: var(--hero-lime);
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.45));
  }

  .hero-marquee {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    height: 80px;
    overflow: hidden;
    border-top: 1px solid var(--hero-line);
    border-bottom: 1px solid var(--hero-line);
    background: rgba(8, 9, 7, 0.72);
    backdrop-filter: blur(6px);
  }

  .hero-marquee-track {
    display: flex;
    align-items: center;
    gap: 28px;
    width: max-content;
    white-space: nowrap;
    animation: hero-marquee 28s linear infinite;
    will-change: transform;
  }

  .hero-marquee-track span {
    color: transparent;
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 2.8vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    -webkit-text-stroke: 1px rgba(243, 245, 241, 0.6);
  }

  .hero-marquee-mark {
    display: inline-block;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    background: var(--hero-red);
    transform: rotate(45deg);
  }

  @keyframes hero-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 1180px) {
    .hero-root {
      --hero-pad: 36px;
    }

    .hero-headline {
      font-size: clamp(2.9rem, 4.7vw, 4.2rem);
    }

    .hero-app-wrap {
      width: min(34vw, 400px);
    }

    .hero-quote {
      width: min(100%, 300px);
      max-width: 300px;
    }
  }

  @media (max-width: 980px) {
    .hero-root {
      --hero-pad: 28px;
      min-height: 100svh;
      min-height: 100dvh;
      /* Isi margin bawah dengan ink supaya browser bar tidak memperlihatkan celah cream. */
      box-shadow: 0 var(--hero-bottom-gap) 0 var(--hero-ink);
      cursor: auto;
    }

    .hero-stage {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 0;
      padding: 0 var(--hero-pad);
    }

    .hero-portrait {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      grid-area: 1 / 1;
      width: 100%;
      height: 100%;
      min-height: 0;
      max-height: none;
      padding: 12px 0 0;
      transform: none;
    }

    /* Di layar sempit, panel merah hanya membingkai foto—bukan
       prosentase tinggi hero yang membuat area merah membengkak. */
    .hero-portrait::before {
      content: '';
      position: absolute;
      z-index: -1;
      top: 4%;
      right: 4%;
      bottom: 0;
      left: 4%;
      background: var(--hero-red);
      clip-path: polygon(0 4%, 100% 0, 100% 96%, 6% 100%);
      transform: skewY(-2deg);
    }

    .hero-portrait-layer picture {
      height: 100%;
    }

    .hero-portrait-layer img {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      object-fit: cover;
      object-position: center 18%;
    }

    .hero-copy {
      position: relative;
      left: auto;
      top: auto;
      grid-area: 2 / 1;
      width: 100%;
      max-width: 620px;
      padding: 8px 0 0;
    }

    .hero-quote {
      display: none;
    }

    .hero-headline {
      font-size: clamp(3.2rem, 7.8vw, 4.6rem);
    }

    .hero-subtext {
      max-width: 36ch;
      margin-top: 16px;
      font-size: clamp(1rem, 1.5vw, 1.2rem);
    }

    /* App satu grid cell dengan portrait, menempel di kanan-bawah.
       Row height tetap ditentukan portrait; copy tidak tertimpa. */
    .hero-app-wrap {
      position: relative;
      right: auto;
      top: auto;
      grid-area: 1 / 1;
      align-self: end;
      justify-self: end;
      width: min(44vw, 280px);
      max-width: 280px;
      margin: 0 0 10px;
      z-index: 12;
    }

    .hero-app-frame {
      transform: rotateY(-5deg) rotateX(2deg) rotateZ(-1deg);
    }

    .hero-plane-red {
      display: none;
    }

    .hero-outline-word {
      bottom: 6%;
      font-size: 34vw;
      opacity: 0.7;
    }

    .hero-plane-lime {
      left: 50%;
    }

    .hero-marquee {
      height: 64px;
    }
  }

  @media (max-width: 640px) {
    .hero-root {
      --hero-pad: 20px;
    }

    .hero-portrait {
      padding: 8px 0 0;
    }

    .hero-portrait::before {
      top: 3%;
      right: 3%;
      left: 3%;
    }

    .hero-portrait-layer img {
      object-position: center 14%;
    }

    /* Mobile: copy jadi penutup hero, jadi beri napas bawah sendiri
       (termasuk safe area) karena marquee dihilangkan. */
    .hero-copy {
      padding: 12px 0 max(40px, env(safe-area-inset-bottom));
    }

    .hero-outline-word {
      bottom: 10%;
      font-size: 42vw;
    }

    .hero-headline {
      font-size: clamp(3.1rem, 13vw, 4rem);
    }

    .hero-subtext {
      margin-top: 20px;
      font-size: 1rem;
    }

    .hero-app-wrap {
      width: min(46vw, 150px);
      max-width: 150px;
      margin: 0 0 8px;
    }

    .hero-app-frame {
      transform: rotateY(-3deg) rotateX(1deg) rotateZ(-1deg);
      box-shadow:
        8px 8px 0 rgba(217, 72, 15, 0.88),
        0 20px 40px rgba(0, 0, 0, 0.5);
    }

    .hero-app-bar {
      height: 28px;
      padding: 0 8px;
      gap: 5px;
      font-size: 8px;
    }

    .hero-app-cursor {
      width: 18px;
      height: 21px;
    }

    /* Mobile: running text bawah dihilangkan; headline + tagline
       memegang dasar hero tanpa elemen yang menempel. */
    .hero-marquee {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-root *,
    .hero-root *::before,
    .hero-root *::after {
      animation: none !important;
      transition: none !important;
    }

    .hero-line {
      opacity: 1;
      clip-path: none;
      transform: none;
    }
  }
</style>

<script>
  // Spotlight reveal: hanya untuk desktop dengan pointer presisi.
  // Tanpa JS / touch / reduced-motion, foto asli tetap tampil (default CSS).
  const hero = document.querySelector<HTMLElement>('.hero-root');

  if (hero) {
    const portrait = hero.querySelector<HTMLElement>('.hero-portrait');
    const baseImg = hero.querySelector<HTMLImageElement>('.hero-portrait-base img');
    const quoteJa = hero.querySelector<HTMLElement>('.hero-quote-ja');
    const quoteEn = hero.querySelector<HTMLElement>('.hero-quote-en');
    const sfxButton = hero.querySelector<HTMLButtonElement>('.hero-sfx');
    const sfxLabel = hero.querySelector<HTMLElement>('.hero-sfx-label');
    const sfxAudio = hero.querySelector<HTMLAudioElement>('.hero-sfx-audio');

    const hoverQuery = window.matchMedia('(min-width: 981px) and (hover: hover) and (pointer: fine)');
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const quotes = [
      { ja: '心を燃やせ', en: 'Set your heart ablaze.' },
      { ja: '胸を張って生きろ', en: 'Live with your head held high.' },
      { ja: '炎柱・煉獄杏寿郎', en: 'I am the Flame Hashira, Kyojuro Rengoku.' },
    ] as const;

    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    let inside = false;
    let quoteTimer = 0;
    let quoteBag: number[] = [];
    let lastQuote = -1;
    let sfxOn = false;
    let lastSfxAt = 0;

    // Shuffle bag: ketiga quote muncul sebelum ada yang diulang.
    const pickQuote = () => {
      if (!quoteBag.length) {
        quoteBag = quotes.map((_, index) => index);
        for (let i = quoteBag.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [quoteBag[i], quoteBag[j]] = [quoteBag[j], quoteBag[i]];
        }
        const last = quoteBag.length - 1;
        if (quoteBag[last] === lastQuote && last > 0) {
          [quoteBag[last], quoteBag[last - 1]] = [quoteBag[last - 1], quoteBag[last]];
        }
      }

      const index = quoteBag.pop();
      if (index === undefined) return;

      lastQuote = index;
      if (quoteJa) quoteJa.textContent = quotes[index].ja;
      if (quoteEn) quoteEn.textContent = quotes[index].en;
    };

    const playSfx = (force = false) => {
      if (!sfxOn || !sfxAudio) return;

      const now = performance.now();
      if (!force && now - lastSfxAt < 1200) return;
      lastSfxAt = now;

      try {
        sfxAudio.currentTime = 0;
        sfxAudio.volume = 0.32;
        const played = sfxAudio.play();
        if (played) void played.catch(() => {});
      } catch {
        // Audio diblokir browser / tidak tersedia: reveal tetap jalan.
      }
    };

    const setSfx = (on: boolean) => {
      sfxOn = on;
      sfxButton?.classList.toggle('is-on', on);
      sfxButton?.setAttribute('aria-pressed', String(on));
      sfxButton?.setAttribute('aria-label', on ? 'SFX ON — matikan efek suara api' : 'SFX OFF — aktifkan efek suara api');
      if (sfxLabel) sfxLabel.textContent = on ? 'SFX ON' : 'SFX OFF';

      if (on) {
        playSfx(true);
      } else if (sfxAudio) {
        sfxAudio.pause();
        sfxAudio.currentTime = 0;
      }
    };

    const deactivate = () => {
      inside = false;
      hero.classList.remove('is-spotting', 'is-quoting');
      window.clearTimeout(quoteTimer);
      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    };

    const revealQuote = () => {
      pickQuote();
      hero.classList.add('is-quoting');
      playSfx();
    };

    const render = () => {
      frame = 0;
      if (!portrait || !baseImg) return;

      const portraitRect = portrait.getBoundingClientRect();
      const imageRect = baseImg.getBoundingClientRect();
      const padX = imageRect.width * 0.12;
      const padY = imageRect.height * 0.05;

      const within =
        pointerX >= imageRect.left + padX &&
        pointerX <= imageRect.right - padX &&
        pointerY >= imageRect.top + padY &&
        pointerY <= imageRect.bottom - padY;

      if (!within) {
        if (inside) deactivate();
        return;
      }

      portrait.style.setProperty('--hero-spot-x', `${pointerX - portraitRect.left}px`);
      portrait.style.setProperty('--hero-spot-y', `${pointerY - portraitRect.top}px`);

      if (!inside) {
        inside = true;
        hero.classList.add('is-spotting');

        // Beri jeda singkat supaya cursor yang cuma lewat tidak memicu quote/audio.
        window.clearTimeout(quoteTimer);
        quoteTimer = window.setTimeout(revealQuote, 160);
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      if (event.target instanceof Element && event.target.closest('.hero-sfx')) {
        if (inside) deactivate();
        return;
      }

      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = requestAnimationFrame(render);
    };

    sfxButton?.addEventListener('click', () => setSfx(!sfxOn));
    setSfx(false);

    const syncEnabled = () => {
      const enabled = hoverQuery.matches && !reduceQuery.matches;
      hero.classList.toggle('is-spot-ready', enabled);
      if (!enabled) deactivate();
    };

    syncEnabled();
    hoverQuery.addEventListener('change', syncEnabled);
    reduceQuery.addEventListener('change', syncEnabled);

    hero.addEventListener('pointermove', onPointerMove, { passive: true });
    hero.addEventListener('pointerleave', deactivate);
  }
</script>
