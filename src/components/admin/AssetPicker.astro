---
// src/components/admin/AssetPicker.astro — pilih cover + galeri dari assets
import { getTransformUrl } from '../../lib/cloudinary';

interface AssetRow {
  id: string;
  cloudinaryPublicId: string;
  originalName: string | null;
}

interface Props {
  assets: AssetRow[];
  coverImageId?: string | null;
  galleryIds?: string[];
}

const { assets, coverImageId = null, galleryIds = [] } = Astro.props;
const thumb = (pid: string) => getTransformUrl(pid, { w: 360, h: 240, c: 'fill' });
---

<div class="space-y-7">
  <div>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant">Cover project</span>
      <a href="/admin/assets" class="text-[11px] font-semibold text-accent hover:underline">Kelola asset →</a>
    </div>

    <div class="flex flex-wrap gap-2.5">
      <label class="cursor-pointer">
        <input type="radio" name="coverImageId" value="" checked={!coverImageId} class="peer sr-only" />
        <span
          class="flex h-20 w-28 items-center justify-center border border-dashed border-outline text-[11px] font-semibold text-on-surface-variant transition-colors duration-150 peer-checked:border-accent peer-checked:text-accent"
        >
          Tanpa cover
        </span>
      </label>

      {
        assets.map((a) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="coverImageId"
              value={a.id}
              checked={coverImageId === a.id}
              class="peer sr-only"
            />
            <img
              src={thumb(a.cloudinaryPublicId)}
              alt={a.originalName ?? 'asset'}
              loading="lazy"
              decoding="async"
              class="h-20 w-28 border border-outline object-cover transition-colors duration-150 peer-checked:ring-2 peer-checked:ring-accent peer-checked:ring-offset-2 peer-checked:ring-offset-background"
            />
          </label>
        ))
      }
    </div>
  </div>

  <div>
    <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-on-surface-variant">
      Galeri project
    </p>
    <p class="mb-2 text-[11px] text-on-surface-variant">Klik untuk memilih. Urutan klik menentukan urutan tampil.</p>

    {
      assets.length === 0 ? (
        <p class="border border-dashed border-outline p-4 text-xs text-on-surface-variant">
          Belum ada asset. Upload dulu di <a href="/admin/assets" class="text-accent hover:underline">Assets</a>.
        </p>
      ) : (
        <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-6">
          {assets.map((a) => (
            <label class="group relative cursor-pointer">
              <input
                type="checkbox"
                data-gallery-input
                value={a.id}
                checked={galleryIds.includes(a.id)}
                class="peer sr-only"
              />
              <img
                src={thumb(a.cloudinaryPublicId)}
                alt={a.originalName ?? 'asset'}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full border border-outline object-cover transition-colors duration-150 peer-checked:ring-2 peer-checked:ring-accent peer-checked:ring-offset-2 peer-checked:ring-offset-background"
              />
              <span
                class="pointer-events-none absolute right-1.5 top-1.5 grid h-5 w-5 place-items-center bg-accent text-white opacity-0 transition-opacity duration-150 peer-checked:opacity-100"
              >
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </label>
          ))}
        </div>
      )
    }
  </div>
</div>
