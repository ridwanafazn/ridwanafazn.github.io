---
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto w-full relative z-20 border-t border-outline bg-background">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-8 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <div class="font-mono text-[12px] font-medium text-on-surface-variant flex items-center gap-2 bg-surface px-4 py-2 rounded-md border border-outline">
      <Icon name="terminal" class="h-[15px] w-[15px] text-on-background" />
      <span>© {currentYear} Ridwan. All rights reserved.<span class="hidden md:inline"> Built with Astro</span></span>
    </div>
    
    <div class="flex gap-6 font-mono text-[12px] uppercase tracking-widest text-on-surface-variant font-semibold">

      <a href="https://www.linkedin.com/in/ridwanafazn/" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 hover:text-accent transition-colors duration-200">
        <BrandIcon name="LinkedIn" class="h-3.5 w-3.5 text-on-surface-variant transition-colors group-hover:text-signal" />
        LinkedIn
      </a>
      <a href="https://github.com/ridwanafazn" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 hover:text-accent transition-colors duration-200">
        <BrandIcon name="GitHub" class="h-3.5 w-3.5 text-on-surface-variant transition-colors group-hover:text-signal" />
        GitHub
      </a>
      <a href="https://www.instagram.com/ridwanafazn/" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 hover:text-accent transition-colors duration-200">
        <BrandIcon name="Instagram" class="h-3.5 w-3.5 text-on-surface-variant transition-colors group-hover:text-signal" />
        Instagram
      </a>
    </div>

  </div>
</footer>
