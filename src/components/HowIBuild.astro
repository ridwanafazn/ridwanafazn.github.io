---
interface Step {
  step: string;
  detail: string;
}

interface HowIBuildData {
  summary: string;
  steps: Step[];
  why: string;
}

interface Props {
  data: HowIBuildData;
}

const { data } = Astro.props;

// Data menyimpan label seperti "01 — Spec"; nomornya sudah dirender terpisah
// di kolom kiri, jadi buang prefix agar tidak tampil dua kali.
const stepLabel = (step: string) => step.replace(/^\d+\s*[—–-]\s*/, '');
---

<section class="mb-0 relative z-10 -mx-6 border-t-[6px] border-signal bg-accent py-20 md:-mx-12 md:py-28">
  <div class="px-6 md:px-12 max-w-7xl mx-auto">

    <div class="mb-16 max-w-2xl reveal">
      <h2 class="text-3xl md:text-4xl text-surface tracking-tight leading-snug">
        Dari ide ke produksi —<br />dengan niat, bukan tergesa.
      </h2>
      <p class="text-left text-[14px] text-surface/70 mt-5 leading-relaxed font-medium max-w-lg">
        {data.summary}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-surface/10 border border-surface/10 rounded-lg overflow-hidden">
      {data.steps.map((s, i) => (
        <div class={`p-8 md:p-10 group hover:bg-surface/5 transition-colors duration-300 reveal ${i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : ''}`}>
          <div class="mb-8 font-mono text-[12px] font-bold tabular-nums text-accent-soft">
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="text-lg text-surface mb-3 tracking-tight">
            {stepLabel(s.step)}
          </h3>
          <p class="text-left text-[13px] text-surface/65 leading-relaxed font-medium">
            {s.detail}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 pt-8 border-t border-surface/10 reveal reveal-delay-2">
      <p class="text-left text-[13px] text-surface/65 max-w-2xl leading-relaxed font-medium">
        {data.why}
      </p>
    </div>

  </div>
</section>
