---
interface Step {
  step: string;
  detail: string;
}

interface HowIBuildData {
  summary: string;
  steps: Step[];
  why: string;
}

interface Props {
  data: HowIBuildData;
}

const { data } = Astro.props;
---

<section class="mb-0 relative z-10 -mx-6 md:-mx-12 py-20 md:py-28 bg-on-background">
  <div class="px-6 md:px-12 max-w-7xl mx-auto">

    <div class="mb-16 max-w-2xl reveal">
      <span class="font-mono text-[10px] uppercase tracking-widest text-accent font-bold block mb-5">Cara Kerja</span>
      <h2 class="text-3xl md:text-4xl font-bold text-surface tracking-tight leading-snug">
        Dari ide ke produksi —<br />dengan niat, bukan tergesa.
      </h2>
      <p class="text-left md:text-justify text-[14px] text-surface/55 mt-5 leading-relaxed font-medium max-w-lg">
        {data.summary}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-surface/10 border border-surface/10 rounded-lg overflow-hidden">
      {data.steps.map((s, i) => (
        <div class={`p-8 md:p-10 group hover:bg-surface/5 transition-colors duration-300 reveal ${i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : ''}`}>
          <div class="font-mono text-[11px] font-bold text-accent/60 mb-8 tabular-nums">
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="font-bold text-[17px] text-surface mb-3 tracking-tight">
            {s.step}
          </h3>
          <p class="text-left md:text-justify text-[13px] text-surface/50 leading-relaxed font-medium">
            {s.detail}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 pt-8 border-t border-surface/10 reveal reveal-delay-2">
      <p class="text-left md:text-justify text-[13px] text-surface/45 max-w-2xl leading-relaxed font-medium">
        {data.why}
      </p>
    </div>

  </div>
</section>
