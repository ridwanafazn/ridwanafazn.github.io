---
import Icon from './Icon.astro';
---

<button
  type="button"
  data-shuffle-projects
  aria-label="Acak proyek"
  class="group inline-flex min-w-[8.5rem] cursor-pointer items-center justify-between gap-2 font-mono text-[12px] font-bold uppercase tracking-wider text-signal-strong transition-colors hover:text-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-60"
>
  <span data-shuffle-label aria-hidden="true" class="max-w-[7rem] overflow-hidden text-ellipsis whitespace-nowrap text-left">
    Acak proyek
  </span>
  <Icon name="arrow-right" class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-shuffle-projects]');
  const label = button?.querySelector<HTMLElement>('[data-shuffle-label]');

  if (button && label) {
    let timer = 0;

    button.addEventListener('click', () => {
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-project-link]'));
      if (links.length === 0) return;

      const chosen = links[Math.floor(Math.random() * links.length)];
      const href = chosen.getAttribute('href');
      if (!href) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        window.location.assign(href);
        return;
      }

      const titles = links.map((link) => link.dataset.projectTitle || 'Proyek');
      button.disabled = true;
      window.clearInterval(timer);

      let ticks = 0;
      timer = window.setInterval(() => {
        label.textContent = titles[Math.floor(Math.random() * titles.length)];
        ticks += 1;

        if (ticks >= 8) {
          window.clearInterval(timer);
          label.textContent = chosen.dataset.projectTitle || 'Buka proyek';
          window.setTimeout(() => window.location.assign(href), 140);
        }
      }, 55);
    });
  }
</script>
