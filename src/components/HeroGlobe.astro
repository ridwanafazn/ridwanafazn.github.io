---
// src/components/HeroGlobe.astro
// Particle globe (diadaptasi dari earth.html).
// Desktop (lg+): globe menempel ke tepi kanan layar, 30% terpotong (tampil 70%).
// Mobile: jadi background redup di belakang teks hero, tetap terpotong di kanan.
// Wajib diletakkan langsung di dalam elemen `relative` (header#hero).
---

<div id="hero-globe-wrap" aria-hidden="true">
  <canvas id="hero-globe-canvas"></canvas>
</div>

<style>
  #hero-globe-wrap {
    position: absolute;
    z-index: -1;
    /* Full-bleed: tepi kiri/kanan wrapper = tepi viewport, lepas dari max-w-7xl */
    left: calc((100% - 100vw) / 2);
    right: calc((100% - 100vw) / 2);
    top: -5rem;
    bottom: -1rem;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease-out;
    --globe-opacity: 0.22;
    /* Mobile: luruhkan sisi bawah supaya tidak terpotong kaku */
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }
  #hero-globe-wrap[data-ready] {
    opacity: var(--globe-opacity);
  }
  #hero-globe-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 1024px) {
    #hero-globe-wrap {
      /* Mulai setelah kolom teks (col-span-7), berakhir tepat di tepi kanan layar */
      left: 58%;
      top: 50%;
      bottom: auto;
      height: var(--hero-globe-h, 560px);
      transform: translateY(-50%);
      pointer-events: auto;
      cursor: grab;
      --globe-opacity: 1;
      -webkit-mask-image: none;
      mask-image: none;
    }
    #hero-globe-wrap:active {
      cursor: grabbing;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const GLOBE_RADIUS = 5;
  const VISIBLE_FRACTION = 0.7; // 70% tampil, 30% terpotong di kanan
  const FOV = 45;

  function latLonToVector3(lat: number, lon: number, radius: number) {
    const phi = (90 - lat) * (Math.PI / 180);
    const theta = (lon + 180) * (Math.PI / 180);
    return new THREE.Vector3(
      -(radius * Math.sin(phi) * Math.cos(theta)),
      radius * Math.cos(phi),
      radius * Math.sin(phi) * Math.sin(theta),
    );
  }

  function buildParticleEarth(img: HTMLImageElement, density: number) {
    const canvas = document.createElement('canvas');
    canvas.width = 1024;
    canvas.height = 512;
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
    const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;

    const positions: number[] = [];
    for (let y = 0; y < canvas.height; y += density) {
      for (let x = 0; x < canvas.width; x += density) {
        // Peta: air putih, daratan hitam
        if (data[(y * canvas.width + x) * 4] < 128) {
          const lat = 90 - (y / canvas.height) * 180;
          const lon = (x / canvas.width) * 360 - 180;
          const p = latLonToVector3(lat, lon, GLOBE_RADIUS);
          positions.push(p.x, p.y, p.z);
        }
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));

    const dot = document.createElement('canvas');
    dot.width = dot.height = 32;
    const dctx = dot.getContext('2d')!;
    dctx.beginPath();
    dctx.arc(16, 16, 14, 0, Math.PI * 2);
    dctx.fillStyle = '#ffffff';
    dctx.fill();

    const material = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.05,
      map: new THREE.CanvasTexture(dot),
      transparent: true,
      alphaTest: 0.1,
      depthWrite: false,
    });
    const points = new THREE.Points(geometry, material);
    points.renderOrder = 1; // gambar setelah inti gelap agar titik daratan tidak tertutup
    return points;
  }

  function buildAtmosphere() {
    const group = new THREE.Group();

    const atmosphere = new THREE.Mesh(
      new THREE.SphereGeometry(GLOBE_RADIUS * 1.05, 64, 64),
      new THREE.ShaderMaterial({
        uniforms: { color: { value: new THREE.Color(0x2a62b3) } },
        vertexShader: `
          varying float intensity;
          void main() {
            vec3 vNormal = normalize(normalMatrix * normal);
            intensity = pow(0.6 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 2.5);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 color;
          varying float intensity;
          void main() {
            gl_FragColor = vec4(color * 1.5, intensity);
          }
        `,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending,
        transparent: true,
        depthWrite: false,
      }),
    );
    group.add(atmosphere);

    // Inti gelap: menyembunyikan titik di sisi belakang & bikin daratan putih menonjol
    const core = new THREE.Mesh(
      new THREE.SphereGeometry(GLOBE_RADIUS * 0.98, 64, 64),
      new THREE.MeshBasicMaterial({ color: 0x020408, transparent: true, opacity: 0.95 }),
    );
    group.add(core);
    return group;
  }

  function initHeroGlobe() {
    const wrap = document.getElementById('hero-globe-wrap');
    const canvas = document.getElementById('hero-globe-canvas') as HTMLCanvasElement | null;
    if (!wrap || !canvas) return;

    const desktopMQ = window.matchMedia('(min-width: 1024px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(FOV, 1, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const earthGroup = new THREE.Group();
    // Rotasi globe ke PI*0.8 agar Indonesia berada di sisi kiri-depan globe saat load
    const INDONESIA_ROTATION = Math.PI * 0.8;
    earthGroup.rotation.y = INDONESIA_ROTATION;
    earthGroup.add(buildAtmosphere());
    scene.add(earthGroup);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enablePan = false;
    controls.enableZoom = false; // jangan bajak scroll halaman
    controls.minPolarAngle = Math.PI * 0.25;
    controls.maxPolarAngle = Math.PI * 0.75;

    // Posisikan globe: diameter D px, pusat di (cx, cy) px dalam canvas.
    // Pakai setViewOffset agar kamera tetap mengorbit pusat globe (OrbitControls aman).
    function layout() {
      const w = wrap!.clientWidth;
      const h = wrap!.clientHeight;
      if (!w || !h) return;
      const isDesktop = desktopMQ.matches;
      controls.enabled = isDesktop;

      const D = isDesktop ? Math.min(h * 0.86, w / 0.8) : Math.max(w * 1.05, h * 0.75);
      // Sisi kiri globe berada di (w - VISIBLE_FRACTION * D) → 30% sisanya lewat tepi kanan
      const cx = w - VISIBLE_FRACTION * D + D / 2;
      const cy = isDesktop ? h / 2 : h * 0.42;

      const visibleHeight = (2 * GLOBE_RADIUS * h) / D;
      const dist = visibleHeight / (2 * Math.tan(THREE.MathUtils.degToRad(FOV / 2)));

      camera.aspect = w / h;
      camera.setViewOffset(w, h, w / 2 - cx, h / 2 - cy, w, h);
      if (camera.position.lengthSq() === 0) camera.position.set(0, dist * 0.12, dist);
      camera.position.setLength(dist);
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    }

    // Tinggi area globe di desktop mengikuti tinggi hero (ukuran asli dipertahankan)
    const hero = wrap.parentElement!;
    function syncHeight() {
      wrap!.style.setProperty('--hero-globe-h', `${Math.max(hero.clientHeight + 160, 560)}px`);
    }

    syncHeight();
    layout();
    const resizeObserver = new ResizeObserver(() => {
      syncHeight();
      layout();
    });
    resizeObserver.observe(wrap);
    resizeObserver.observe(hero);
    desktopMQ.addEventListener('change', layout);

    let isVisible = true;
    const visibilityObserver = new IntersectionObserver(
      (entries) => (isVisible = entries[0].isIntersecting),
      { threshold: 0 },
    );
    visibilityObserver.observe(wrap);

    const base = import.meta.env.BASE_URL;
    const img = new Image();
    img.onload = () => {
      // Kapit awal agar Indonesia berada di sisi kiri globe begitu partikel terlihat
      earthGroup.rotation.y = INDONESIA_ROTATION;
      // Mobile cukup kepadatan lebih rendah supaya ringan
      earthGroup.add(buildParticleEarth(img, desktopMQ.matches ? 2 : 3));
      wrap.setAttribute('data-ready', '');
    };
    img.onerror = () => wrap.setAttribute('data-ready', '');
    img.src = `${base.endsWith('/') ? base : base + '/'}textures/earth-water.png`;

    let animId = 0;
    function animate() {
      animId = requestAnimationFrame(animate);
      if (!isVisible) return;
      if (!reducedMotion) earthGroup.rotation.y += 0.0015;
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => {
      cancelAnimationFrame(animId);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      desktopMQ.removeEventListener('change', layout);
      controls.dispose();
      renderer.dispose();
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroGlobe);
  } else {
    initHeroGlobe();
  }
</script>
