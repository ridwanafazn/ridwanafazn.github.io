---
// src/components/HeroGlobe.astro
// Particle globe (three.js). Hanya dimuat di >=1024px, setelah browser idle.
// Tetap hidup saat resize / client-side navigation; di-reinit kalau DOM diganti.
// Wajib diletakkan langsung di dalam elemen `relative` (header#hero).
---

<div id="hero-globe-wrap" aria-hidden="true">
  <canvas id="hero-globe-canvas"></canvas>
</div>

<style>
  #hero-globe-wrap {
    display: none;
  }

  @media (min-width: 1024px) {
    #hero-globe-wrap {
      display: block;
      position: absolute;
      z-index: -1;
      overflow: hidden;
      pointer-events: auto;
      cursor: grab;
      opacity: 0;
      transition: opacity 0.8s ease-out;
      left: 58%;
      /* Menembus container max-w-7xl sampai tepi kanan viewport */
      right: calc((100% - 100vw) / 2);
      /* Naik ke belakang navbar dan turun ke belakang spec strip */
      top: -7rem;
      /* Berhenti tepat di garis atas spec strip (hero mb-20 = 80px). */
      bottom: -5rem;
      height: auto;
      /* Tanpa mask: tidak ada gradasi putih. Globe dipotong bersih oleh
         panel spec strip yang opaque di bawahnya. */
      mask-image: none;
    }

    #hero-globe-wrap:active {
      cursor: grabbing;
    }

    #hero-globe-wrap[data-ready] {
      opacity: 1;
    }

    /* WebGL/tekstur gagal: jangan sisakan kotak kosong atau error di console. */
    #hero-globe-wrap[data-failed] {
      display: none;
    }

    #hero-globe-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>

<script>
  const desktop = window.matchMedia('(min-width: 1024px)');
  let loading = false;

  const ensureGlobe = async () => {
    if (!desktop.matches || loading) return;

    const wrap = document.getElementById('hero-globe-wrap');
    const canvas = document.getElementById('hero-globe-canvas');
    if (!wrap || !canvas) return;

    loading = true;
    try {
      const { initHeroGlobe } = await import('../scripts/hero-globe');
      initHeroGlobe();
    } catch {
      // Bundle three.js gagal dimuat / inisialisasi melempar: halaman harus
      // tetap utuh tanpa globe, bukan unhandled rejection.
      wrap.setAttribute('data-failed', '');
    } finally {
      loading = false;
    }
  };

  const whenIdle = () => {
    if ('requestIdleCallback' in window) {
      (
        window as Window & {
          requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void;
        }
      ).requestIdleCallback(ensureGlobe, { timeout: 2500 });
    } else {
      window.setTimeout(ensureGlobe, 1200);
    }
  };

  // ClientRouter: jalan lagi setiap halaman siap (termasuk kembali ke home).
  document.addEventListener('astro:page-load', whenIdle);

  // Desktop ↔ mobile: muat saat melewati breakpoint, re-layout saat kembali.
  desktop.addEventListener('change', () => {
    if (desktop.matches) whenIdle();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', whenIdle);
  } else {
    whenIdle();
  }
</script>
