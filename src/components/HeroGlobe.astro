---
// src/components/HeroGlobe.astro
// Particle globe (three.js). Hanya dimuat di >=1024px setelah browser idle,
// supaya mobile tidak membayar 559 KB (texture 420 KB + three.js).
// Wajib diletakkan langsung di dalam elemen `relative` (header#hero).
---

<div id="hero-globe-wrap" aria-hidden="true">
  <canvas id="hero-globe-canvas"></canvas>
</div>

<style>
  #hero-globe-wrap {
    display: none;
  }

  @media (min-width: 1024px) {
    #hero-globe-wrap {
      display: block;
      position: absolute;
      z-index: -1;
      overflow: hidden;
      pointer-events: auto;
      cursor: grab;
      opacity: 0;
      transition: opacity 0.8s ease-out;
      left: 58%;
      /* Menembus container max-w-7xl sampai tepi kanan viewport */
      right: calc((100% - 100vw) / 2);
      /* Naik ke belakang navbar dan turun ke belakang spec strip */
      top: -7rem;
      bottom: -7rem;
      height: auto;
    }

    #hero-globe-wrap:active {
      cursor: grabbing;
    }

    #hero-globe-wrap[data-ready] {
      opacity: 1;
    }

    #hero-globe-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>

<script>
  const start = async () => {
    const wrap = document.getElementById('hero-globe-wrap');
    const canvas = document.getElementById('hero-globe-canvas');
    if (!wrap || !canvas) return;
    if (!window.matchMedia('(min-width: 1024px)').matches) return;

    const { initHeroGlobe } = await import('../scripts/hero-globe');
    initHeroGlobe();
  };

  if ('requestIdleCallback' in window) {
    (window as Window & { requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void })
      .requestIdleCallback(start, { timeout: 2500 });
  } else {
    window.setTimeout(start, 1200);
  }
</script>
