---
import { getProfile } from '../lib/content';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Satu sumber URL CV untuk tombol desktop dan mobile (selalu sinkron).
const FALLBACK_CV_URL = 'https://drive.google.com/file/d/18hfmx1ihy07zoZb7eB4SipBsbU2QK-PT/view';
let cvUrl = '';
try {
  cvUrl = (await getProfile()).cvUrl ?? '';
} catch {
  cvUrl = '';
}
const resumeHref = cvUrl || FALLBACK_CV_URL;

const joinPath = (path: string) => {
  const cleanBase = base.endsWith('/') ? base : `${base}/`;
  const cleanPath = path.startsWith('/') ? path.substring(1) : path;
  return `${cleanBase}${cleanPath}`;
};

const isCurrent = (targetPath: string) => {
  const normalizedCurrent = currentPath.replace(/\/$/, '') || '/';
  const normalizedTarget = joinPath(targetPath).replace(/\/$/, '') || '/';
  
  if (normalizedTarget === '/') return normalizedCurrent === '/';
  return normalizedCurrent.startsWith(normalizedTarget);
};
---

<header class="fixed top-0 w-full z-50 flex justify-center mt-0 md:mt-4 pointer-events-none">
  
  <div data-nav-shell data-scrolled="false" class="nav-shell relative z-50 pointer-events-auto bg-background/70 backdrop-blur-md supports-[backdrop-filter]:bg-background/60 border-b md:border border-outline w-full md:w-auto md:rounded-md px-6 md:px-8 h-16 flex items-center justify-between gap-6 md:gap-16 transition-all duration-300">
    
    <a href={joinPath('/')} class="flex items-center gap-2 group shrink-0">
      <span class="font-mono font-bold text-on-background group-hover:text-accent transition-colors tracking-tight text-[15px]">
        ridwanafazn
      </span>
      <span class="w-1.5 h-3.5 bg-on-background"></span>
    </a>

    <nav class="hidden md:flex items-center gap-8 pt-1">
      <a href={joinPath('/')} class={`text-[13px] transition-all duration-300 pb-1.5 border-b-[2px] ${isCurrent('/') ? 'font-bold text-on-background border-signal' : 'font-medium text-on-surface-variant border-transparent hover:text-on-background'}`}>
        Home
      </a>
      <a href={joinPath('/about')} class={`text-[13px] transition-all duration-300 pb-1.5 border-b-[2px] ${isCurrent('/about') ? 'font-bold text-on-background border-signal' : 'font-medium text-on-surface-variant border-transparent hover:text-on-background'}`}>
        About
      </a>
      <a href={joinPath('/projects')} class={`text-[13px] transition-all duration-300 pb-1.5 border-b-[2px] ${isCurrent('/projects') ? 'font-bold text-on-background border-signal' : 'font-medium text-on-surface-variant border-transparent hover:text-on-background'}`}>
        Projects
      </a>
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center justify-center border border-outline-strong text-on-surface-variant font-mono text-[12px] uppercase tracking-wider font-bold px-4 py-2 rounded-md hover:bg-surface-hover hover:text-on-background hover:border-on-background transition-all duration-300">
        Resume
      </a>
      <a href="mailto:ridwanafzn@gmail.com" class="hidden sm:inline-flex items-center justify-center bg-signal-strong text-white font-mono text-[12px] uppercase tracking-wider font-bold px-5 py-2.5 rounded-md border border-signal-strong hover:bg-signal-hover hover:border-signal-hover active:scale-95 transition-all duration-300">
        Hire Me
      </a>
      
      <button type="button" id="mobile-menu-btn" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden flex items-center justify-center p-2 rounded-md bg-surface hover:bg-surface-hover transition-colors text-on-background">
        <Icon id="menu-icon-open" name="menu" class="h-6 w-6" />
        <Icon id="menu-icon-close" name="close" class="hidden h-6 w-6" />
      </button>
    </div>

    <div class="nav-progress" aria-hidden="true"><span></span></div>
  </div>

  <div
    id="mobile-menu"
    data-open="false"
    class="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menu navigasi"
    tabindex="-1"
  >

    <nav class="flex flex-col gap-8 w-full px-8 pt-32 pb-12">
      
      <a href={joinPath('/')} class={`group flex flex-col gap-1 transition-colors ${isCurrent('/') ? 'text-signal-strong' : 'text-on-surface-variant hover:text-on-background'}`}>
        <span class="font-mono text-[12px] font-bold tracking-widest uppercase opacity-60 flex items-center gap-2">
          <span class="w-4 h-px bg-current"></span> 01 //
        </span>
        <span class="text-4xl font-bold tracking-tight">Home</span>
      </a>

      <a href={joinPath('/about')} class={`group flex flex-col gap-1 transition-colors ${isCurrent('/about') ? 'text-signal-strong' : 'text-on-surface-variant hover:text-on-background'}`}>
        <span class="font-mono text-[12px] font-bold tracking-widest uppercase opacity-60 flex items-center gap-2">
          <span class="w-4 h-px bg-current"></span> 02 //
        </span>
        <span class="text-4xl font-bold tracking-tight">About</span>
      </a>

      <a href={joinPath('/projects')} class={`group flex flex-col gap-1 transition-colors ${isCurrent('/projects') ? 'text-signal-strong' : 'text-on-surface-variant hover:text-on-background'}`}>
        <span class="font-mono text-[12px] font-bold tracking-widest uppercase opacity-60 flex items-center gap-2">
          <span class="w-4 h-px bg-current"></span> 03 //
        </span>
        <span class="text-4xl font-bold tracking-tight">Project Vault</span>
      </a>
      
      <div class="w-full h-px bg-outline/40 my-4"></div>
      
      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-between w-full p-5 rounded-md border border-outline-strong bg-surface hover:bg-surface-hover hover:border-accent transition-colors group">
        <div class="flex items-center gap-3">
          <Icon name="file-text" class="h-[18px] w-[18px] text-accent" />
          <span class="font-mono text-[12px] font-bold uppercase tracking-widest text-on-background">View Resume</span>
        </div>
        <Icon name="arrow-right" class="h-[18px] w-[18px] text-on-surface-variant transition-colors group-hover:text-accent" />
      </a>

      <a href="mailto:ridwanafzn@gmail.com" class="inline-flex items-center justify-between w-full p-5 rounded-md bg-signal-strong text-white border border-signal-strong hover:bg-signal-hover hover:border-signal-hover transition-colors group">
        <div class="flex items-center gap-3">
          <Icon name="mail" class="h-[18px] w-[18px]" />
          <span class="font-mono text-[12px] font-bold uppercase tracking-widest">Hire Me</span>
        </div>
        <Icon name="arrow-right" class="h-[18px] w-[18px] transition-transform group-hover:translate-x-1" />
      </a>

    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var shell = null;
    var opener = null;

    function syncNav() {
      if (!shell || !shell.isConnected) shell = document.querySelector('[data-nav-shell]');
      if (!shell) return;
      shell.setAttribute('data-scrolled', String(window.scrollY > 16));
    }

    function menuOf(element) {
      var header = element && element.closest ? element.closest('header') : null;
      return header ? header.querySelector('.mobile-menu') : null;
    }

    function focusables(root) {
      return Array.prototype.slice
        .call(
          root.querySelectorAll(
            'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
          ),
        )
        .filter(function (el) {
          return el.offsetParent !== null;
        });
    }

    // Konten di belakang overlay tidak boleh menerima fokus/klik.
    function setPageInert(on) {
      ['main', 'footer'].forEach(function (selector) {
        var el = document.querySelector(selector);
        if (!el) return;
        if (on) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      });
    }

    function setMenu(menu, open, trigger) {
      if (!menu) return;

      var header = menu.closest('header');
      var btn = header ? header.querySelector('#mobile-menu-btn') : null;

      document.querySelectorAll('.mobile-menu').forEach(function (other) {
        if (other !== menu) other.setAttribute('data-open', 'false');
      });

      menu.setAttribute('data-open', String(open));

      if (btn) {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      }

      var iconOpen = header ? header.querySelector('#menu-icon-open') : null;
      var iconClose = header ? header.querySelector('#menu-icon-close') : null;
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);

      document.body.style.overflow = open ? 'hidden' : '';
      setPageInert(open);

      if (open) {
        opener = trigger || btn || document.activeElement;
        var items = focusables(menu);
        (items[0] || menu).focus();
      } else {
        var back = opener;
        opener = null;
        if (back && back.isConnected) back.focus();
      }
    }

    // Tanpa memindahkan fokus — dipakai saat load, resize, klik link, pageshow.
    function closeAll() {
      document.querySelectorAll('.mobile-menu').forEach(function (menu) {
        menu.setAttribute('data-open', 'false');
      });
      document.querySelectorAll('#mobile-menu-btn').forEach(function (btn) {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Buka menu navigasi');
      });
      document.querySelectorAll('#menu-icon-open').forEach(function (icon) {
        icon.classList.remove('hidden');
      });
      document.querySelectorAll('#menu-icon-close').forEach(function (icon) {
        icon.classList.add('hidden');
      });
      document.body.style.overflow = '';
      setPageInert(false);
      opener = null;
    }

    if (!window.__navBound) {
      window.__navBound = true;

      syncNav();
      window.addEventListener('scroll', syncNav, { passive: true });

      document.addEventListener(
        'click',
        function (event) {
          var target = event.target instanceof Element ? event.target : null;
          if (!target) return;

          var btn = target.closest('#mobile-menu-btn');
          if (btn) {
            event.preventDefault();
            var menu = menuOf(btn);
            setMenu(menu, !menu || menu.getAttribute('data-open') !== 'true', btn);
            return;
          }

          if (target.closest('.mobile-menu a')) closeAll();
        },
        true,
      );

      document.addEventListener('keydown', function (event) {
        var menu = document.querySelector('.mobile-menu[data-open="true"]');
        if (!menu) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          setMenu(menu, false);
          return;
        }

        if (event.key !== 'Tab') return;

        var items = focusables(menu);
        if (!items.length) {
          event.preventDefault();
          menu.focus();
          return;
        }

        var first = items[0];
        var last = items[items.length - 1];
        var active = document.activeElement;

        if (event.shiftKey && (active === first || active === menu)) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.matchMedia('(min-width: 768px)').matches) closeAll();
      });

      // Kembali dari bfcache: jangan biarkan menu/scroll-lock nyangkut.
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          closeAll();
          syncNav();
        }
      });
    }

    closeAll();
  })();
</script>
