---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="mb-8 relative z-10 reveal">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-outline border border-outline rounded-lg overflow-hidden">
    {stats.map((stat, index) => (
      <div class="bg-surface px-8 py-8 flex flex-col gap-2 group hover:bg-surface-hover transition-colors duration-300">
        <span
          class="font-mono text-4xl md:text-5xl font-bold text-accent tracking-tight leading-none stat-number"
          data-target={stat.value}
        >
          {stat.value}
        </span>
        <span class="font-mono text-[10px] uppercase tracking-widest text-on-surface-variant font-semibold">
          {stat.label}
        </span>
      </div>
    ))}
  </div>
</section>

<script>
  function runCountUp(el: Element) {
    const raw = el.getAttribute('data-target') ?? '';
    const match = raw.match(/^(\d+)(.*)$/);
    if (!match) return;

    const target = parseInt(match[1], 10);
    const suffix = match[2];
    const duration = 900;
    const start = performance.now();

    // Tahun 4-digit tanpa suffix — tampilkan langsung, skip count-up
    if (target > 999 && !suffix) return;

    el.textContent = '0' + suffix;

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      el.textContent = current + suffix;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  const statSection = document.querySelector('.stat-number')?.closest('section');
  if (statSection) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.querySelectorAll('.stat-number').forEach(runCountUp);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    obs.observe(statSection);
  }
</script>
