---
// Ikon inline (stroke 1.75) — pengganti Material Symbols di halaman publik.
// Tidak ada request font ikon; ikon dekoratif selalu aria-hidden.
interface Props {
  id?: string;
  name:
    | 'arrow-right'
    | 'arrow-left'
    | 'chevron-right'
    | 'chevron-left'
    | 'menu'
    | 'close'
    | 'zoom-in'
    | 'check-circle'
    | 'mail'
    | 'file-text'
    | 'terminal'
    | 'cpu'
    | 'award'
    | 'users'
    | 'graduation-cap'
    | 'briefcase'
    | 'external-link';
  class?: string;
}

const inner: Record<string, string> = {
  'arrow-right': '<path d="M4 12h15"/><path d="M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H5"/><path d="M11 18l-6-6 6-6"/>',
  'chevron-right': '<path d="M9 6l6 6-6 6"/>',
  'chevron-left': '<path d="M15 6l-6 6 6 6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  'zoom-in':
    '<circle cx="11" cy="11" r="6"/><path d="M11 8.5v5"/><path d="M8.5 11h5"/><path d="M20.5 20.5L16 16"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="M8.4 12.2l2.5 2.5 4.7-5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.6 7l8.4 6 8.4-6"/>',
  'file-text':
    '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v5h4"/><path d="M10 13h6"/><path d="M10 17h6"/>',
  terminal: '<path d="M4 7l4 4-4 4"/><path d="M12 17h7"/>',
  cpu: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M12 3v4"/><path d="M12 17v4"/><path d="M3 12h4"/><path d="M17 12h4"/>',
  award: '<circle cx="12" cy="9" r="5"/><path d="M8.6 13.4L7 21l5-2.5L17 21l-1.6-7.6"/>',
  users:
    '<path d="M15.5 20v-1.4a3.6 3.6 0 0 0-3.6-3.6H7.1a3.6 3.6 0 0 0-3.6 3.6V20"/><circle cx="9.5" cy="8" r="3.2"/><path d="M17 5.2a3 3 0 0 1 0 5.6"/><path d="M20.5 20v-1.4a3.6 3.6 0 0 0-2.7-3.5"/>',
  'graduation-cap':
    '<path d="M2.5 9L12 5l9.5 4L12 13 2.5 9z"/><path d="M6 10.8V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.2"/><path d="M21.5 9v5"/>',
  briefcase:
    '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7"/>',
  'external-link':
    '<path d="M14 4h6v6"/><path d="M20 4l-8.5 8.5"/><path d="M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5"/>',
};

const { name, class: className = 'h-[18px] w-[18px]', id } = Astro.props;
const svg = inner[name] ?? inner['external-link'];
---

<svg
  id={id}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={svg}
/>
