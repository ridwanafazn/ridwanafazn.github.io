# ============================================================
# Portofx v2 — ENV
# ============================================================
# WAJIB cuma ~13 var (bagian 1–5). Sisanya opsional.
# - Build-time PUBLIC_*  -> .env.local / GitHub Actions
# - Runtime secret       -> wrangler secret put (production)
# - Local dev            -> .env.local
# ============================================================

# ── 1. Neon (WAJIB) ─────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── 2. Better Auth (WAJIB) ─────────────────────────────────
BETTER_AUTH_SECRET="openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:4321"

# ── 3. Cloudinary (WAJIB untuk upload asset) ───────────────
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxx"
CLOUDINARY_UPLOAD_PRESET="ml_default"

# ── 4. Public (WAJIB, build-time) ──────────────────────────
PUBLIC_SITE_URL="http://localhost:4321"
PUBLIC_SITE_NAME="Ridwan Afazn"
PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud"
PUBLIC_CLOUDINARY_UPLOAD_PRESET="ml_default"

# ── 5. Seed admin (opsional, ada default) ──────────────────
ADMIN_EMAIL="admin@portofx.dev"
ADMIN_PASSWORD="admin12345"

# ============================================================
# OPSIONAL — hanya isi kalau dipakai
# ============================================================
# CLOUDINARY_FOLDER="portfolio"
# AUTH_COOKIE_NAME="auth_session"
# AUTH_COOKIE_DOMAIN="localhost"
# AUTH_COOKIE_SECURE="false"
# AUTH_TRUSTED_ORIGINS="http://localhost:4321"# CSRF_SECRET=""
# RATE_LIMIT_MAX="5"
# RATE_LIMIT_WINDOW="60"

# ── Deploy Cloudflare (CI/CD) ──────────────────────────────
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ZONE_ID=""
# CLOUDFLARE_WORKERS_SUBDOMAIN="portofx-v2.workers.dev"
# CLOUDFLARE_ENV="production"

# ── Migrasi Sanity (sudah selesai; dihapus) ────────────────

# ── Monitoring / email / analytics (opsional) ──────────────
# SENTRY_DSN=""
# RESEND_API_KEY=""
# PUBLIC_UMAMI_WEBSITE_ID=""
